}

# ---------- Web-UI ----------
# python3-Kindprozess (PY_WEB): liest Zustand/Log aus Dateien in $TMPD und schickt
# Befehle als "W;KEY;VAL"-Zeilen ins Event-FIFO (fd 3) — ui_loop führt sie wie Tasten aus.
WEB_STATE="$TMPD/web.state"; WEB_LOG="$TMPD/web.log"; WEB_DEV="$TMPD/web.devices"
read -r -d '' PY_WEB <<'PY'
import sys, os, json, re, threading, base64, hmac
from http.server import ThreadingHTTPServer, BaseHTTPRequestHandler
from urllib.parse import urlparse, parse_qs

port, tmpd, fifo, htmlpath = int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4]
AUTH = None
if os.environ.get("LB_WEB_USER") and os.environ.get("LB_WEB_PASS"):
    AUTH = base64.b64encode((os.environ["LB_WEB_USER"] + ":" + os.environ["LB_WEB_PASS"]).encode()).decode()
os.environ.pop("LB_WEB_USER", None)
os.environ.pop("LB_WEB_PASS", None)
MAC = re.compile(r"^([0-9a-f]{2}:){5}[0-9a-f]{2}$")
BOOL_KEYS = {"filter": "filter_on", "block": "block_on", "tg": "tg_on", "pause": "paused", "file": "file_on"}
lock = threading.Lock()

def rd(name):
    try:
        with open(os.path.join(tmpd, name), encoding="utf-8", errors="replace") as f:
            return f.read().splitlines()
    except OSError:
        return []

def toint(v):
    try:
        return int(v)
    except ValueError:
        return 0

def state():
    kv = {}
    for ln in rd("web.state"):
        k, _, v = ln.partition("\t")
        kv[k] = v
    macs = kv.get("filter_macs", "")
    allf = macs in ("", "ALL")
    devs = []
    for ln in rd("dev.tsv"):
        p = ln.split("\x1f")
        if len(p) >= 6 and p[3]:
            devs.append({"active": p[0] == "1", "name": p[1], "ip": p[2], "mac": p[3].lower(),
                         "iface": p[4], "guest": p[5] == "1"})
    st = {k: kv.get(k, "0") == "1" for k in ("filter_on", "block_on", "tg_on", "paused", "file_on", "tg_conf")}
    st.update({"bl_count": toint(kv.get("bl_count", "0")), "filter_macs": [] if allf else macs.split(","),
               "filter_all": allf, "filter_names": kv.get("filter_names", ""),
               "total": toint(kv.get("total", "0")), "hits": toint(kv.get("hits", "0")),
               "reconnect": toint(kv.get("reconnect", "0")), "devices": devs})
    return st

def log_since(since):
    rows, last = [], since
    for ln in rd("web.log"):
        p = ln.split("\t")
        if len(p) < 6:
            continue
        n = toint(p[0])
        if n > since:
            rows.append([p[1], p[2], p[3], p[4], p[5]])
            last = max(last, n)
    return {"last": last, "rows": rows}

def send_cmd(line):
    data = line.encode()
    if len(data) >= 512:
        raise OSError("zu lang")
    fd = os.open(fifo, os.O_WRONLY | os.O_NONBLOCK)
    try:
        os.write(fd, data)
    finally:
        os.close(fd)

def apply_set(key, value):
    """→ (status, payload)"""
    if key in BOOL_KEYS:
        if isinstance(value, bool) or value in (0, 1):
            send_cmd("W;%s;%d\n" % (key, 1 if value else 0))
            return 200, {"ok": True}
        return 400, {"error": "value muss bool sein"}
    if key == "clear":
        send_cmd("W;clear;\n")
        return 200, {"ok": True}
    if key == "refresh":
        send_cmd("W;refresh;\n")
        return 200, {"ok": True}
    if key == "devices":
        if not isinstance(value, list) or not all(isinstance(m, str) and MAC.match(m) for m in value):
            return 400, {"error": "ungültige MAC-Liste"}
        with lock:
            p = os.path.join(tmpd, "web.devices")
            with open(p + ".tmp", "w") as f:
                f.write((",".join(value) or "ALL") + "\n")
            os.replace(p + ".tmp", p)
            send_cmd("W;devices;\n")
        return 200, {"ok": True}
    return 400, {"error": "unbekannter Schlüssel"}

class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def reply(self, code, body, ctype="application/json; charset=utf-8"):
        if not isinstance(body, bytes):
            body = (body if isinstance(body, str) else json.dumps(body)).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def authed(self):
        if AUTH is None:
            return True
        h = self.headers.get("Authorization", "")
        if h.startswith("Basic ") and hmac.compare_digest(h[6:].strip().encode(), AUTH.encode()):
            return True
        body = b"Anmeldung erforderlich"
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="lauschbox", charset="UTF-8"')
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)
        return False

    def do_GET(self):
        if not self.authed():
            return
        u = urlparse(self.path)
        if u.path == "/":
            self.reply(*page())
        elif u.path == "/api/state":
            self.reply(200, state())
        elif u.path == "/api/log":
            try:
                since = int(parse_qs(u.query).get("since", ["0"])[0])
            except ValueError:
                since = 0
            self.reply(200, log_since(since))
        else:
            self.reply(404, {"error": "nicht gefunden"})

    def do_POST(self):
        if not self.authed():
            return
        if urlparse(self.path).path != "/api/set":
            return self.reply(404, {"error": "nicht gefunden"})
        try:
            n = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            n = -1
        if n < 0 or n > 65536:
            return self.reply(400, {"error": "Body ungültig oder zu groß"})
        try:
            req = json.loads(self.rfile.read(n) or b"{}")
            key, value = req["key"], req.get("value")
        except (ValueError, KeyError, TypeError):
            return self.reply(400, {"error": "JSON {key,value} erwartet"})
        try:
            code, payload = apply_set(key, value)
        except OSError:
            code, payload = 503, {"error": "lauschbox nicht erreichbar"}
        self.reply(code, payload)

def page():
    """web.html bei jedem Aufruf frisch lesen → (status, body, ctype)"""
    try:
        with open(htmlpath, "rb") as f:
            return 200, f.read(), "text/html; charset=utf-8"
    except OSError:
        return 500, "web.html nicht lesbar: " + htmlpath, "text/plain; charset=utf-8"

ThreadingHTTPServer(("0.0.0.0", port), H).serve_forever()
PY

web_state_write() {
  local tgc=0 pz=0
  [[ -n $TG_TOKEN && -n $TG_CHAT_ID ]] && tgc=1
  ((PAUSED || LOG_OFF > 0)) && pz=1
  printf '%s\t%s\n' filter_on "$FILTER_ON" block_on "$BLOCK_ON" tg_on "$TG_ON" paused "$pz" \
    file_on "$FILE_ON" tg_conf "$tgc" bl_count "$BL_COUNT" filter_macs "$DEVICE_FILTER" \
    filter_names "$DEVICE_FILTER_NAMES" total "$CNT_TOTAL" hits "$CNT_HIT" reconnect "$RECONNECT" \
    > "$WEB_STATE.tmp" && mv -f "$WEB_STATE.tmp" "$WEB_STATE"
}

web_log_append() {  # TS NAME IP DOMAIN HIT
  WEB_SEQ=$((WEB_SEQ + 1))
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$WEB_SEQ" "$1" "$2" "$3" "$4" "$5" >> "$WEB_LOG"
}

web_cmd() {  # web_cmd KEY VAL — explizite Werte (idempotent)
  local cur csv m macs="" re='^([0-9a-f]{2}:){5}[0-9a-f]{2}$'
  case $1 in
    filter|block|tg|pause|file)
      case $1 in
        filter) cur=$FILTER_ON ;;
        block)  cur=$BLOCK_ON ;;
        tg)     cur=$TG_ON ;;
        pause)  cur=0; ((PAUSED || LOG_OFF > 0)) && cur=1 ;;
        file)   cur=$FILE_ON ;;
      esac
      if [[ $cur != "$2" ]]; then
        case $1 in
          filter) toggle_filter ;;
          block)  toggle_block ;;
          tg)     toggle_tg || msg "⚠ Telegram nicht konfiguriert (Menü → Telegram)" ;;
          pause)  toggle_pause ;;
          file)   toggle_file ;;
        esac
      fi ;;
    clear) clear_buffers; : > "$WEB_LOG" ;;
    refresh)
      if [[ -z $DEVREF_PID ]]; then
        DEV_AT=$SECONDS
        fetch_devices "$TMPD/dev.new" &
        DEVREF_PID=$!
      fi ;;
    devices)
      csv=""
      IFS= read -r csv < "$WEB_DEV" 2>/dev/null
      local IFS=,
      for m in $csv; do
        [[ $m =~ $re ]] && macs+="${macs:+,}$m"
      done
      IFS=$' \t\n'
      apply_filter_macs "$macs"
      FILTER_ON=1
      draw_rule; draw_bar; msg "Gerätefilter (Web): $DEVICE_FILTER_NAMES" ;;
  esac
  web_state_write
}

web_start() {  # Rückgabe 1: keine web.html; 2: Basic Auth unvollständig (nur WEB_USER oder nur WEB_PASS)
  web_html_path || return 1
  [[ -z $WEB_USER && -z $WEB_PASS ]] || [[ -n $WEB_USER && -n $WEB_PASS && $WEB_USER != *:* ]] || return 2
  web_state_write
  : > "$WEB_LOG"
  LB_WEB_USER="$WEB_USER" LB_WEB_PASS="$WEB_PASS" python3 -c "$PY_WEB" "$WEB_PORT" "$TMPD" "$FIFO_OUT" "$R_LINE" >/dev/null 2>&1 &
  WEB_PID=$!
}

web_stop() {
  kill_wait "$WEB_PID"
  WEB_PID=""
}

toggle_web() {
  if ((WEB_ON)); then
    WEB_ON=0; web_stop; msg "Web-UI aus"
  else
    web_start; case $? in
      0) WEB_ON=1; WEB_URL="http://$(hostname):$WEB_PORT"
         if [[ -n $WEB_USER ]]; then msg "Web-UI an (Login aktiv)"; else msg "Web-UI an"; fi ;;
      2) msg "⚠ Web-UI-Login: WEB_USER und WEB_PASS beide setzen (Benutzer ohne ':') in lauschbox.env" ;;
      *) msg "⚠ web.html fehlt (WEB_HTML in lauschbox.env, ./web.html oder $CONFIG_DIR/web.html)" ;;
    esac
  fi
  draw_rule; draw_bar
}

ui_loop() {
  EVENT=""
  local f1 f2 f3 f4 f5 h
  while IFS=';' read -r f1 f2 f3 f4 f5 <&3; do
    case $f1 in
      T) on_tick ;;
      K)
        case $f2 in
          UP)   log_scroll 1 ;;
          DOWN) log_scroll -1 ;;
          PGUP) log_scroll "$LOG_VIEW_H" ;;
          PGDN) log_scroll "-$LOG_VIEW_H" ;;
          HOME) log_scroll "${#LOG_BUF[@]}" ;;
          END)  PAUSED=0; log_scroll "-${#LOG_BUF[@]}" ;;
          WUP)  log_scroll 3 ;;
          WDN)  log_scroll -3 ;;
          g) toggle_filter ;;
          s) toggle_block ;;
          p) toggle_pause ;;
          l) toggle_file ;;
          c) clear_buffers ;;
          w) toggle_web ;;
          e) EVENT=e; return ;;
          t) toggle_tg || { EVENT=t; return; } ;;
          x|q) EVENT=x; return ;;
        esac ;;
      W) web_cmd "$f2" "$f3" ;;
      "") : ;;
      *) handle_query "$f1" "$f2" "$f3" "$f4" "$f5" ;;
    esac
  done
}

# ---------- Menüpunkt 1: Verbindung Fritzbox ----------
ui_fritzbox() {
  screen
  title "⇄ Verbindung Fritzbox"
  if [[ -f $ENV_FB ]]; then
    confirm "$ENV_FB existiert bereits. Überschreiben?" || return 1
    echo
  fi
  info "ℹ  Standard-IP: 192.168.178.1 bzw. fritz.box — entspricht dem Gateway"
  info "   deines Rechners (Heimnetz → Netzwerk im Webinterface)."
  ask FB_IP "${C_TEXT}IP-Adresse der Fritzbox${C_RESET}"
  [[ -z $FB_IP ]] && { warn "Abgebrochen — keine IP eingegeben."; anykey; return 1; }
  echo
  info "ℹ  FRITZ!Box-Benutzer (nicht „nur Kennwort“). System → FRITZ!Box-Benutzer,"
  info "   Recht „FRITZ!Box Einstellungen“. Zusätzlich: Heimnetz → Netzwerk →"
  info "   Netzwerkeinstellungen → „Zugriff für Anwendungen zulassen“ (TR-064)."
  ask FB_USER "${C_TEXT}Nutzername${C_RESET}"
  [[ -z $FB_USER ]] && { warn "Abgebrochen — kein Nutzername eingegeben."; anykey; return 1; }
  echo
  info "ℹ  Passwort des FRITZ!Box-Benutzers (Eingabe verdeckt)."
  ask FB_PASS "${C_TEXT}Passwort${C_RESET}" secret
  [[ -z $FB_PASS ]] && { warn "Abgebrochen — kein Passwort eingegeben."; anykey; return 1; }
  save_fb
  echo
  ok "✔ Gespeichert in $ENV_FB"
  step "Teste Login"
  if fb_login; then step_ok "Login erfolgreich"
  else step_fail "Login fehlgeschlagen — Zugangsdaten / Benutzerrecht / BlockTime prüfen"; fi
  anykey
  return 0
}

