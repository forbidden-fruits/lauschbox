#!/usr/bin/env bash
#
# lauschbox 2 — DNS-Lauscher für die FRITZ!Box (optimierte Variante)
#
# Gegenüber `lauschbox`:
#   Technik   Geräteliste in EINEM Request (statt N SOAP-Calls), Login und
#             Geräteliste parallel, Secrets nie in argv (ps-sicher), Auto-
#             Reconnect bei Capture-Abbruch, Resize-Handling, sicherer
#             .env-Parser (kein `source`), private Temp-Dir, Alt-Screen,
#             O(1)-Gerätenamen- und O(Labels)-Sperrlisten-Lookup ohne Forks.
#   Funktion  Checkbox-Auswahl für Geräte (auch Offline-Geräte), Menü mit
#             Pfeiltasten, Duplikat-Unterdrückung (A/AAAA/HTTPS-Bursts),
#             Telegram-Cooldown, Pause, Puffer leeren, Datei-Log, Statistik,
#             hosts-Format in der Sperrliste, Verbindungstests.
#   Optik     Banner mit Farbverlauf, Dashboard, Sparkline (Anfragen/s),
#             Statusleiste, Pill-Tastenleiste, Spaltenlayout, Trefferbalken.
#
# Nutzt dieselben Konfig-Dateien wie `lauschbox` (kompatibel).
# bash >= 3.2 (macOS-System-Bash).
#
set -u
set -f
shopt -s nocasematch

VERSION="2.0"
US=$'\037'
NL=$'\n'

usage() {
  cat <<EOF
lauschbox $VERSION — DNS-Lauscher für die FRITZ!Box

Aufruf: lauschbox [Option]
  -l, --log        direkt in die DNS-Logging-Ansicht starten
      --no-color   ohne Farben (auch via NO_COLOR=1)
  -V, --version    Version anzeigen
  -h, --help       diese Hilfe
EOF
}

AUTOSTART=0
for _a in "$@"; do
  case $_a in
    -h|--help)    usage; exit 0 ;;
    -V|--version) echo "lauschbox $VERSION"; exit 0 ;;
    -l|--log)     AUTOSTART=1 ;;
    --no-color)   NO_COLOR=1 ;;
    *) echo "Unbekannte Option: $_a" >&2; usage >&2; exit 2 ;;
  esac
done
unset _a

if [[ ! -t 0 || ! -t 1 ]]; then
  echo "lauschbox braucht ein interaktives Terminal." >&2
  exit 1
fi

# ---------- Pfade & Einstellungen ----------
CONFIG_DIR="$HOME/.config/lauschbox"
conf_path() {  # zuerst CWD, sonst ~/.config/lauschbox
  if [[ -f $PWD/$1 ]]; then printf '%s/%s' "$PWD" "$1"
  else printf '%s/%s' "$CONFIG_DIR" "$1"; fi
}
ENV_FB="$(conf_path .fritzbox.env)"
ENV_TG="$(conf_path .telegram.env)"
ENV_DEV="$(conf_path .devices.env)"
