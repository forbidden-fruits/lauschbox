  else
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
    if : >> "$LOG_FILE" 2>/dev/null; then FILE_ON=1; TODAY=$(date +%F); msg "Datei-Log an → $LOG_FILE"
    else msg "⚠ $LOG_FILE nicht beschreibbar"; fi
  fi
