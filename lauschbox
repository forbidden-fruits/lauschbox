  load_env "$ENV_DEV" DEVICE_FILTER DEVICE_FILTER_NAMES || return 1
  [[ -n $DEVICE_FILTER ]]
}

# ---------- Fritzbox: Login (SID) ----------
# Passwort läuft per Umgebung ins python-Kind — nie in argv (ps-sicher).
read -r -d '' PY_LOGIN <<'PY'
import sys, os, urllib.request, urllib.parse, hashlib
import xml.etree.ElementTree as ET
ip, user = sys.argv[1:3]
pw = os.environ.get("LB_PASS", "")
base = f"http://{ip}/login_sid.lua"

def rd(url, data=None):
    with urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=8) as r:
        return ET.fromstring(r.read())

try:
    root = rd(base + "?version=2")
except Exception as e:
    print(f"Fehler: {e}", file=sys.stderr); sys.exit(1)

sid = root.findtext("SID") or ""
ch = root.findtext("Challenge") or ""
bt = root.findtext("BlockTime") or "0"
if bt != "0":
    print(f"BlockTime {bt}s aktiv (zu viele Fehlversuche)", file=sys.stderr)

if ch.startswith("2$"):
    try:
        _, it1, salt1, it2, salt2 = ch.split("$")
        h1 = hashlib.pbkdf2_hmac("sha256", pw.encode(), bytes.fromhex(salt1), int(it1))
        h2 = hashlib.pbkdf2_hmac("sha256", h1, bytes.fromhex(salt2), int(it2))
        post = urllib.parse.urlencode({"username": user, "response": f"{salt2}${h2.hex()}"}).encode()
        sid = rd(base + "?version=2", post).findtext("SID") or ""
    except Exception as e:
        print(f"Fehler (V2): {e}", file=sys.stderr)

if sid in ("", "0000000000000000"):
    try:
        root = rd(base)
        ch = root.findtext("Challenge") or ""
        h = hashlib.md5((ch + "-" + pw).encode("utf-16-le")).hexdigest()
        post = urllib.parse.urlencode({"username": user, "response": f"{ch}-{h}"}).encode()
        sid = rd(base, post).findtext("SID") or ""
    except Exception as e:
        print(f"Fehler (V1): {e}", file=sys.stderr)
print(sid)
PY

fb_login_raw() { LB_PASS="$FB_PASS" python3 -c "$PY_LOGIN" "$FB_IP" "$FB_USER" 2>/dev/null; }

fb_login() {
  SID=$(fb_login_raw)
  [[ -n $SID && $SID != "0000000000000000" ]]
}

# ---------- Fritzbox: Geräteliste (TR-064) ----------
# Bevorzugt X_AVM-DE_GetHostListPath: EIN Request für alle Hosts (statt einem
# SOAP-Call pro Gerät). Fallback: GetGenericHostEntry-Schleife (alte Firmware).
# Ausgabe pro Gerät: aktiv \x1f name \x1f ip \x1f mac \x1f iface \x1f gast
read -r -d '' PY_DEVICES <<'PY'
import sys, os, urllib.request
import xml.etree.ElementTree as ET
ip, user = sys.argv[1:3]
pw = os.environ.get("LB_PASS", "")
base = f"http://{ip}:49000"
URN = "urn:dslforum-org:service:Hosts:1"
mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
mgr.add_password(None, base + "/", user, pw)
op = urllib.request.build_opener(urllib.request.HTTPDigestAuthHandler(mgr))

def soap(action, inner=""):
    body = ('<?xml version="1.0" encoding="utf-8"?>'
            '<s:Envelope s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"'
            ' xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">'
            f'<s:Body><u:{action} xmlns:u="{URN}">{inner}</u:{action}></s:Body></s:Envelope>').encode()
    req = urllib.request.Request(base + "/upnp/control/hosts", data=body, headers={
        "Content-Type": 'text/xml; charset="utf-8"', "SoapAction": f"{URN}#{action}"})
    root = ET.fromstring(op.open(req, timeout=10).read())
    return {el.tag.split("}")[-1]: (el.text or "") for el in root.iter()
            if el.tag.split("}")[-1].startswith("New")}

rows = {}
def add(name, ipa, mac, act, ifc, guest):
    mac = mac.strip().lower()
    if mac:
        rows[mac] = (act == "1", name.replace("\x1f", " ").strip(), ipa.strip(), mac, ifc.strip(), guest == "1")

try:
    path = soap("X_AVM-DE_GetHostListPath")["NewX_AVM-DE_HostListPath"]
    root = ET.fromstring(op.open(base + path, timeout=20).read())
    for it in root.iter("Item"):
        g = lambda t: (it.findtext(t) or "").strip()
        add(g("HostName"), g("IPAddress"), g("MACAddress"), g("Active"),
            g("InterfaceType"), g("X_AVM-DE_Guest"))
except Exception as e1:
    try:
        n = int(soap("GetHostNumberOfEntries")["NewHostNumberOfEntries"])
        for i in range(n):
