# ---------- Fritzbox: Login (SID) ----------
fb_login() {
  SID=$(python3 - "$FB_IP" "$FB_USER" "$FB_PASS" <<'PY'
import sys, urllib.request, urllib.parse, hashlib
import xml.etree.ElementTree as ET
ip, user, pw = sys.argv[1:4]
base = f"http://{ip}/login_sid.lua"

def rd(url, data=None):
    with urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=10) as r:
        return ET.fromstring(r.read())

try:
    root = rd(base + "?version=2")
except Exception as e:
    print(f"Fehler: {e}", file=sys.stderr)
    sys.exit(1)

sid = root.findtext("SID") or ""
ch = root.findtext("Challenge") or ""
bt = root.findtext("BlockTime") or "0"
if bt != "0":
    print(f"Hinweis: BlockTime {bt}s aktiv (zu viele Fehlversuche).", file=sys.stderr)

if ch.startswith("2$"):
    try:
        _, it1, salt1, it2, salt2 = ch.split("$")
        h1 = hashlib.pbkdf2_hmac("sha256", pw.encode(), bytes.fromhex(salt1), int(it1))
        h2 = hashlib.pbkdf2_hmac("sha256", h1, bytes.fromhex(salt2), int(it2))
        post = urllib.parse.urlencode({"username": user, "response": f"{salt2}${h2.hex()}"}).encode()
        sid = rd(base + "?version=2", post).findtext("SID") or ""
    except Exception as e:
        print(f"Fehler (V2): {e}", file=sys.stderr)

if sid in ("", "0000000000000000"):
    try:
        root = rd(base)
        ch = root.findtext("Challenge") or ""
        h = hashlib.md5((ch + "-" + pw).encode("utf-16-le")).hexdigest()
        post = urllib.parse.urlencode({"username": user, "response": f"{ch}-{h}"}).encode()
        sid = rd(base, post).findtext("SID") or ""
    except Exception as e:
        print(f"Fehler (V1): {e}", file=sys.stderr)

print(sid)
PY
  )
  [[ -n $SID && $SID != "0000000000000000" ]]
}

# ---------- Fritzbox: Geräteliste (TR-064, Digest Auth) ----------
fetch_devices() {
  local tmp n ip mac ifc
  tmp=$(mktemp /tmp/lauschbox-dev.XXXXXX)
  if python3 - "$FB_IP" "$FB_USER" "$FB_PASS" > "$tmp" <<'PY'
import sys, urllib.request
import xml.etree.ElementTree as ET
ip, user, pw = sys.argv[1:4]
url = f"http://{ip}:49000/upnp/control/hosts"
URN = "urn:dslforum-org:service:Hosts:1"
mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
mgr.add_password(None, url, user, pw)
opener = urllib.request.build_opener(urllib.request.HTTPDigestAuthHandler(mgr))

def soap(action, inner=""):
    body = ('<?xml version="1.0" encoding="utf-8"?>'
            '<s:Envelope s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"'
            ' xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">'
            f'<s:Body><u:{action} xmlns:u="{URN}">{inner}</u:{action}></s:Body></s:Envelope>').encode()
    req = urllib.request.Request(url, data=body, headers={
        "Content-Type": 'text/xml; charset="utf-8"', "SoapAction": f"{URN}#{action}"})
    root = ET.fromstring(opener.open(req, timeout=10).read())
    out = {}
    for el in root.iter():
        tag = el.tag.split("}")[-1]
        if tag.startswith("New"):
            out[tag] = el.text or ""
    return out

try:
    n = int(soap("GetHostNumberOfEntries")["NewHostNumberOfEntries"])
except Exception as e:
    print(f"Fehler: {e}", file=sys.stderr)
    sys.exit(1)

for i in range(n):
    print(f"\r  … Gerät {i+1}/{n}", end="", file=sys.stderr, flush=True)
    try:
        e = soap("GetGenericHostEntry", f"<NewIndex>{i}</NewIndex>")
    except Exception:
        continue
    if e.get("NewActive") != "1":
        continue
    name = e.get("NewHostName", "").replace("\t", " ")
    print("\t".join([name, e.get("NewIPAddress", ""),
                     e.get("NewMACAddress", "").lower(), e.get("NewInterfaceType", "")]))
print("\r" + " " * 30 + "\r", end="", file=sys.stderr, flush=True)
PY
  then
    DEV_NAME=(); DEV_IP=(); DEV_MAC=(); DEV_IF=(); DEV_COUNT=0
    while IFS=$'\t' read -r n ip mac ifc; do
      DEV_NAME+=("$n"); DEV_IP+=("$ip"); DEV_MAC+=("$mac"); DEV_IF+=("$ifc")
      DEV_COUNT=$((DEV_COUNT + 1))
    done < "$tmp"
    rm -f "$tmp"
    return 0
  else
    rm -f "$tmp"
    return 1
  fi
}

dev_by_mac() {
  R_NAME=""
  local i
  for ((i = 0; i < DEV_COUNT; i++)); do
    if [[ ${DEV_MAC[$i]} == "$1" ]]; then R_NAME=${DEV_NAME[$i]}; return 0; fi
  done
  return 1
}

# ---------- Fritzbox: Paketaufzeichnung ----------
capture_stopall() {
  curl -s --max-time 8 \
    "http://${FB_IP}/cgi-bin/capture_notimeout?iface=stopall&capture=Stop&sid=${SID}" \
    -o /dev/null 2>/dev/null
}

key_writer() {
  while read_key; do
    [[ -n $R_KEY && $R_KEY != NONE ]] && printf 'K;%s\n' "$R_KEY"
  done
}

capture_start() {
  FIFO_PCAP=$(mktemp -u /tmp/lauschbox-pcap.XXXXXX)
  FIFO_OUT=$(mktemp -u /tmp/lauschbox-out.XXXXXX)
  mkfifo "$FIFO_PCAP" "$FIFO_OUT"
  exec 3<> "$FIFO_OUT"
  tshark -l -i - -Y 'dns.flags.response == 0' -T fields -E separator=';' \
    -e frame.time -e eth.src -e ip.src -e ipv6.src -e dns.qry.name \
    < "$FIFO_PCAP" > "$FIFO_OUT" 2>/dev/null &
  TSHARK_PID=$!
  curl -s -N --connect-timeout 5 \
    "http://${FB_IP}/cgi-bin/capture_notimeout?sid=${SID}&capture=Start&snaplen=&filter=&ifaceorminor=1-lan" \
    > "$FIFO_PCAP" 2>/dev/null &
  CURL_PID=$!
  key_writer > "$FIFO_OUT" &
  KEY_PID=$!
}

capture_stop() {
  [[ -n $KEY_PID ]]    && { kill "$KEY_PID"    2>/dev/null; wait "$KEY_PID"    2>/dev/null; } 2>/dev/null
  restore_tty
  [[ -n $CURL_PID ]]   && { kill "$CURL_PID"   2>/dev/null; wait "$CURL_PID"   2>/dev/null; } 2>/dev/null
  [[ -n $TSHARK_PID ]] && { kill "$TSHARK_PID" 2>/dev/null; wait "$TSHARK_PID" 2>/dev/null; } 2>/dev/null
  exec 3>&- 3<&-
  [[ -n $FIFO_PCAP ]] && rm -f "$FIFO_PCAP"
  [[ -n $FIFO_OUT ]]  && rm -f "$FIFO_OUT"
  KEY_PID=""; CURL_PID=""; TSHARK_PID=""; FIFO_PCAP=""; FIFO_OUT=""
}

# ---------- Sperrliste ----------
load_blocklist() {
  BLOCK_ENTRIES=()
  [[ -f $BLOCKLIST_FILE ]] || return 1
  local l
  while IFS= read -r l || [[ -n $l ]]; do
    l=${l%%#*}
    l="${l#"${l%%[![:space:]]*}"}"
    l="${l%"${l##*[![:space:]]}"}"
    [[ -n $l ]] && BLOCK_ENTRIES+=("$l")
  done < "$BLOCKLIST_FILE"
  ((${#BLOCK_ENTRIES[@]} > 0))
}

blocklist_help() {
  warn "⚠️  Keine blocklist.txt gefunden."
  echo
  printf '  Lege die Datei %s%s%s an. Format: eine Domain pro Zeile, z.B.:\n\n' "$C_TEAL" "$BLOCKLIST_FILE" "$C_RESET"
  printf '    %sexample.com%s\n' "$C_TEXT" "$C_RESET"
  printf '    %stracking.example.org%s\n\n' "$C_TEXT" "$C_RESET"
  printf '  Ein Eintrag matcht auch alle Subdomains (sub.example.com → example.com).\n'
  printf '  Zeilen mit %s#%s am Zeilenanfang sind Kommentare.\n' "$C_PEACH" "$C_RESET"
}

domain_hit() {
  local d=${1%.} b
  for b in ${BLOCK_ENTRIES[@]+"${BLOCK_ENTRIES[@]}"}; do
    [[ $d == "$b" || $d == *".$b" ]] && return 0
  done
  return 1
}

# ---------- Telegram ----------
tg_send() {
  [[ -n $TG_TOKEN && -n $TG_CHAT_ID ]] || return 0
  curl -s --max-time 10 -X POST "https://api.telegram.org/bot${TG_TOKEN}/sendMessage" \
    --data-urlencode "chat_id=${TG_CHAT_ID}" \
    --data-urlencode "text=$1" >/dev/null 2>&1 &
}

tg_notify() {  # name ip domain — jeder Treffer löst eine Nachricht aus
  [[ $TG_ON == 1 ]] || return 0
  tg_send "🚨 lauschbox: Sperrlisten-Treffer
Gerät: $1 ($2)
Domain: $3
Zeit: $(date '+%H:%M:%S')"
}

# ---------- DNS-Logging-Ansicht ----------
bar_stat() {
  if [[ $1 == 1 ]]; then printf '%sAn%s' "$C_GREEN" "$C_RESET"
  else printf '%sAus%s' "$C_RED" "$C_RESET"; fi
}

draw_bar() {
  local seg_t
  if [[ $BLOCK_ON == 1 ]]; then
    seg_t="${C_MAUVE}<t>${C_TEXT}-Telegram $(bar_stat "$TG_ON")"
  else
    seg_t="${C_OVERLAY}<t>-Telegram Aus"
  fi
  printf '\0337\033[%d;1H\033[2K' "$ROWS"
  printf '  %b-Gerätefilter %b   %b-Gerätefilter ändern   %b-Sperrliste %b   %b   %b-Hauptmenü%s' \
    "${C_MAUVE}<g>${C_TEXT}" "$(bar_stat "$FILTER_ON")" \
    "${C_MAUVE}<e>${C_TEXT}" \
    "${C_MAUVE}<s>${C_TEXT}" "$(bar_stat "$BLOCK_ON")" \
    "$seg_t" \
    "${C_MAUVE}<x>${C_TEXT}" "$C_RESET"
  printf '\0338'
}

msg() { printf '\0337\033[%d;1H\033[2K  %s%s%s\0338' "$((ROWS - 1))" "$C_PEACH" "$1" "$C_RESET"; }

dns_line() {  # ts name ip domain hit(0/1) → farbige Zeile in R_LINE
  local dc=$C_TEXT
  [[ $5 == 1 ]] && dc=$C_RED
  R_LINE="${C_OVERLAY}$1 ${C_SKY}$2 ${C_BLUE}$3 ${dc}$4${C_RESET}"
}

log_push() {  # Zeile an Ringpuffer anhängen, auf LOG_MAX_LINES kappen
  LOG_BUF+=("$1")
  if ((${#LOG_BUF[@]} > LOG_MAX_LINES)); then
    # kein negativer Slice-Offset (bash 3.2): positiv berechnen
    LOG_BUF=("${LOG_BUF[@]:$(( ${#LOG_BUF[@]} - LOG_MAX_LINES ))}")
  fi
}

log_render() {  # Fenster LOG_BUF[n-LOG_OFF-h .. n-LOG_OFF-1] absolut zeichnen
  # kein trailing \n → die Scroll-Region bleibt unberührt
  local n=${#LOG_BUF[@]} start i
  start=$((n - LOG_OFF - LOG_VIEW_H))
  ((start < 0)) && start=0
  for ((i = 0; i < LOG_VIEW_H; i++)); do
    printf '\033[%d;1H\033[2K' $((VIEW_TOP + i))
    ((start + i < n)) && printf '%s' "${LOG_BUF[start + i]}"
  done
  printf '\033[%d;1H' "$VIEW_BOT"   # Follow-Ausgabe setzt unten an
}

log_scroll() {  # delta > 0 = hoch (ältere), delta < 0 = runter (Richtung Live)
  local n=${#LOG_BUF[@]} max_off
  max_off=$((n - LOG_VIEW_H)); ((max_off < 0)) && max_off=0
  LOG_OFF=$((LOG_OFF + $1))
  ((LOG_OFF > max_off)) && LOG_OFF=$max_off
  ((LOG_OFF < 0)) && LOG_OFF=0
  LOG_NEW=0
  log_render
  if ((LOG_OFF == 0)); then
    msg "📡 Live-Ansicht — ↑/↓ PgUp/PgDn = scrollen"
  else
    msg "⏸ Angepinnt — $LOG_OFF Einträge über dem Live-Ende · <Ende> = Live-Log"
  fi
}

handle_line() {
  local ftime fmac fip4 fip6 fnames ts ip name d
  IFS=';' read -r ftime fmac fip4 fip6 fnames <<< "$1"
  [[ -z $fnames ]] && return 0
  if [[ $FILTER_ON == 1 && $DEVICE_FILTER != ALL ]]; then
    [[ ,$DEVICE_FILTER, == *,$fmac,* ]] || return 0
  fi
  ts=$ftime
  [[ $ftime =~ [0-9]{2}:[0-9]{2}:[0-9]{2} ]] && ts=${BASH_REMATCH[0]}
  name="unbekannt"
  dev_by_mac "$fmac" && name=${R_NAME:-unbekannt}
  ip=${fip4:-$fip6}; [[ -z $ip ]] && ip="-"
  local -a names=()
  IFS=',' read -r -a names <<< "$fnames"
  for d in ${names[@]+"${names[@]}"}; do
    [[ -z $d ]] && continue
    local hit=0
    domain_hit "$d" && hit=1
    if [[ $BLOCK_ON == 1 ]]; then
      ((hit == 1)) || continue      # Sperrliste an: nur Treffer anzeigen
      tg_notify "$name" "$ip" "$d"
    fi
    dns_line "$ts" "$name" "$ip" "$d" "$hit"   # Treffer immer rot markieren
    log_push "$R_LINE"
    if ((LOG_OFF == 0)); then
      printf '%s\n' "$R_LINE"      # Follow-Modus: Region scrollt selbst
    else
      LOG_NEW=$((LOG_NEW + 1))     # angepinnt: puffern, Anzeige einfrieren
      msg "⏸ Angepinnt — $LOG_NEW neue Einträge · <Ende> = Live-Log"
    fi
  done
}

ui_loop() {
  EVENT=""
  local line k
  while IFS= read -r line <&3; do
    case $line in
      K\;*)
        k=${line#K;}
        case $k in
          UP)   log_scroll 1 ;;
          DOWN) log_scroll -1 ;;
          PGUP) log_scroll "$LOG_VIEW_H" ;;
          PGDN) log_scroll "-$LOG_VIEW_H" ;;
          HOME) log_scroll "${#LOG_BUF[@]}" ;;
          END)  log_scroll "-${#LOG_BUF[@]}" ;;
          WUP)  log_scroll 3 ;;
          WDN)  log_scroll -3 ;;
          g)
            if [[ $FILTER_ON == 1 ]]; then
              FILTER_ON=0; msg "🔇 Gerätefilter aus — alle Geräte werden geloggt."
            else
              FILTER_ON=1; msg "🔎 Gerätefilter an: $DEVICE_FILTER_NAMES"
            fi
            draw_bar ;;
          e) EVENT=e; return ;;
          s)
            if [[ $BLOCK_ON == 1 ]]; then
              BLOCK_ON=0; TG_ON=0
              msg "🚫 Sperrliste aus — alle DNS-Anfragen werden angezeigt."
            elif load_blocklist; then
              BLOCK_ON=1
              msg "🚫 Sperrliste an (${#BLOCK_ENTRIES[@]} Einträge) — nur Treffer werden angezeigt."
            else
              msg "⚠️  blocklist.txt fehlt — Format: eine Domain pro Zeile (s. Hauptmenü → Sperrliste anzeigen)."
            fi
            draw_bar ;;
          t)
            if [[ $BLOCK_ON != 1 ]]; then
              msg "⚠️  Telegram nur bei aktiver Sperrliste (Taste s) möglich."
            elif [[ $TG_ON == 1 ]]; then
              TG_ON=0; draw_bar; msg "✈️  Telegram-Benachrichtigung aus."
            elif load_tg; then
              TG_ON=1; draw_bar; msg "✈️  Telegram-Benachrichtigung an."
            else
              EVENT=t; return
            fi ;;
          x) EVENT=x; return ;;
        esac ;;
      "") : ;;
      *) handle_line "$line" ;;
    esac
  done
}

view_setup() {
  local bl
  ROWS=$(tput lines)
  bl=$(banner_rows)
  VIEW_TOP=$((bl + 3)); VIEW_BOT=$((ROWS - 2))
  LOG_VIEW_H=$((VIEW_BOT - VIEW_TOP + 1))
  LOG_BUF=(); LOG_OFF=0; LOG_NEW=0
  screen
  tput civis 2>/dev/null
  printf '\033[?1002h\033[?1006h'   # Mausrad-Events (SGR) fürs Scrollen
  printf '\033[%d;%dr' "$VIEW_TOP" "$VIEW_BOT"
  printf '\033[%d;1H' "$VIEW_TOP"
  draw_bar
  msg "📡 Logging läuft (Interface 1-lan) — Gerätefilter: $DEVICE_FILTER_NAMES · ↑/↓ = scrollen"
}

# Content-Screens mit langem Inhalt (Listen): Banner oben fixieren,
# Inhalt scrollt in der Region darunter — gilt für die gesamte Anwendung
content_region_on() {
  local bl
  ROWS=$(tput lines)
  bl=$(banner_rows)
  printf '\033[%d;%dr' $((bl + 3)) "$ROWS"
  printf '\033[%d;1H' $((bl + 3))
}
content_region_off() { printf '\033[r'; }

view_teardown() { printf '\033[r\033[?1002l\033[?1006l'; tput cnorm 2>/dev/null; }

abort_logging() {
  capture_stop
  capture_stopall
  printf '\033[r\033[?1002l\033[?1006l'
  tput cnorm 2>/dev/null
  clear
  exit 130
}

# ---------- Menüpunkt 1: Verbindung Fritzbox ----------
ui_fritzbox() {
  screen
  printf '  %s%s🔌 Verbindung Fritzbox%s\n\n' "$C_BOLD" "$C_MAUVE" "$C_RESET"
  if [[ -f $ENV_FB ]]; then
    confirm_overwrite "$ENV_FB" || return 1
    echo
  fi
  info "ℹ️  Standard-IP: 192.168.178.1 bzw. fritz.box — entspricht der"
  info "   Gateway-Adresse deines Rechners (Heimnetz → Netzwerk im Webinterface)."
  ask FB_IP "${C_TEXT}IP-Adresse der Fritzbox${C_RESET}"
  [[ -z $FB_IP ]] && { warn "Abgebrochen — keine IP eingegeben."; keypress; return 1; }
  echo
  info "ℹ️  FRITZ!Box-Benutzer (nicht „nur Kennwort“). Anlegen im Webinterface:"
  info "   System → FRITZ!Box-Benutzer → Benutzer hinzufügen (Recht „FRITZ!Box"
  info "   Einstellungen“). Außerdem: Heimnetz → Netzwerk → Netzwerkeinstellungen"
  info "   → „Zugriff für Anwendungen zulassen“ aktivieren (TR-064)."
  ask FB_USER "${C_TEXT}Nutzername${C_RESET}"
  [[ -z $FB_USER ]] && { warn "Abgebrochen — kein Nutzername eingegeben."; keypress; return 1; }
  echo
  info "ℹ️  Passwort des FRITZ!Box-Benutzers (Eingabe verdeckt)."
  ask FB_PASS "${C_TEXT}Passwort${C_RESET}" secret
  [[ -z $FB_PASS ]] && { warn "Abgebrochen — kein Passwort eingegeben."; keypress; return 1; }
  save_fb
  echo
  ok "✅ Gespeichert in $ENV_FB"
  keypress
  return 0
}

