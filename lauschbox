# ---------- Menüpunkt 3: Gerätefilter (Checkbox-Liste) ----------
ui_devices() {
  if ! load_fb; then
    screen; title "▣ Gerätefilter"
    warn "Keine Fritzbox-Verbindung konfiguriert — bitte zuerst einrichten."
    anykey
    ui_fritzbox || return 1
    load_fb || return 1
  fi
  screen; title "▣ Gerätefilter"
  step "Lade Geräteliste von $FB_IP"
  if ! fetch_devices "$TMPD/dev.tsv"; then
    step_fail "Geräteliste nicht ladbar (Zugangsdaten / TR-064 prüfen)"
    anykey; return 1
  fi
  load_devices "$TMPD/dev.tsv"
  if ((DEV_COUNT == 0)); then step_fail "Keine Geräte gefunden"; anykey; return 1; fi
  step_ok "$DEV_COUNT Geräte geladen"

  local -a chk=()
  local i cur=0 off=0 top h nsel k icon line nm dot cb mark ipd
  load_filter || true
  for ((i = 0; i < DEV_COUNT; i++)); do
    chk[i]=0
    [[ $DEVICE_FILTER != ALL && ,$DEVICE_FILTER, == *",${DEV_MAC[i]},"* ]] && chk[i]=1
  done
  layout
  top=$((HDR_ROWS + 4)); h=$((ROWS - top - 1)); ((h < 3)) && h=3
  printf '\033[%d;1H\033[2K  %sLeertaste%s wählen · %sa%s alle Geräte · %sn%s keine · %sEnter%s speichern · %sq%s abbrechen' \
    "$((HDR_ROWS + 3))" "$C_MAUVE" "$C_OVERLAY" "$C_MAUVE" "$C_OVERLAY" "$C_MAUVE" "$C_OVERLAY" "$C_MAUVE" "$C_OVERLAY" "$C_MAUVE" "$C_OVERLAY"
  printf '\033[?25l\033[?1000h\033[?1006h'
  while true; do
    ((cur < off)) && off=$cur
    ((cur >= off + h)) && off=$((cur - h + 1))
    nsel=0; for ((i = 0; i < DEV_COUNT; i++)); do ((chk[i])) && nsel=$((nsel + 1)); done
    for ((i = 0; i < h; i++)); do
      k=$((off + i))
      printf '\033[%d;1H\033[2K' $((top + i))
      ((k < DEV_COUNT)) || continue
      icon='·'
      case ${DEV_IF[k]} in 802.11) icon='≋' ;; Ethernet) icon='═' ;; esac
      [[ ${DEV_GUEST[k]} == 1 ]] && icon='◇'
      nm=${DEV_NAME[k]:-(ohne Namen)}
      ((${#nm} > 26)) && nm="${nm:0:25}…"
      if [[ ${DEV_ACT[k]} == 1 ]]; then dot="${C_GREEN}●"; else dot="${C_OVERLAY}○"; fi
      if ((chk[k])); then cb="${C_GREEN}[✔]"; else cb="${C_OVERLAY}[ ]"; fi
      if ((k == cur)); then mark="${C_SEL}${C_MAUVE}▸"; else mark=" "; fi
      line="$mark $cb $dot ${C_MAUVE}$icon "
      if [[ ${DEV_ACT[k]} == 1 ]]; then line+="${C_SKY}"; else line+="${C_OVERLAY}"; fi
      ipd=${DEV_IP[k]:--}
      line+="$nm${SPACES:0:$((26 - ${#nm}))} ${C_BLUE}${ipd}${SPACES:0:$((15 - ${#ipd}))} ${C_OVERLAY}${DEV_MAC[k]}"
      printf '  %s' "$line"
      ((k == cur)) && printf '\033[K'
      printf '%s' "$C_RESET"
    done
    printf '\033[%d;1H\033[2K  %s%d von %d ausgewählt%s' "$ROWS" "$C_OVERLAY" "$nsel" "$DEV_COUNT" "$C_RESET"
    ((nsel == 0)) && printf '%s — ohne Auswahl: Alle Netzwerkgeräte%s' "$C_OVERLAY" "$C_RESET"
    ((DEV_COUNT > h)) && printf '%s · ↑/↓ PgUp/PgDn scrollen%s' "$C_OVERLAY" "$C_RESET"
    read_key || break
    case $R_KEY in
      UP)   cur=$((cur - 1)) ;;
      DOWN) cur=$((cur + 1)) ;;
      PGUP) cur=$((cur - h)) ;;
      PGDN) cur=$((cur + h)) ;;
      HOME) cur=0 ;;
      END)  cur=$((DEV_COUNT - 1)) ;;
      WUP)  cur=$((cur - 3)) ;;
      WDN)  cur=$((cur + 3)) ;;
      " ")  chk[cur]=$((1 - chk[cur])) ;;
      a)    for ((i = 0; i < DEV_COUNT; i++)); do chk[i]=0; done; nsel=0; break ;;
      n)    for ((i = 0; i < DEV_COUNT; i++)); do chk[i]=0; done ;;
      "")   break ;;
      q|ESC)
        printf '\033[?25h\033[?1000l\033[?1006l'
        return 1 ;;
    esac
    ((cur < 0)) && cur=0
    ((cur >= DEV_COUNT)) && cur=$((DEV_COUNT - 1))
  done
  printf '\033[?25h\033[?1000l\033[?1006l'
  local macs=""
  nsel=0
  for ((i = 0; i < DEV_COUNT; i++)); do
    if ((chk[i])); then macs+="${macs:+,}${DEV_MAC[i]}"; nsel=$((nsel + 1)); fi
  done
  apply_filter_macs "$macs"
  printf '\033[%d;1H\033[2K  %s✔ Gerätefilter gespeichert: %s%s' "$ROWS" "$C_GREEN" "$DEVICE_FILTER_NAMES" "$C_RESET"
  sleep 1
  return 0
}

# ---------- Menüpunkt 4: DNS Logging ----------
ui_logging() {
  if ! load_fb; then
    screen; title "◉ DNS Logging"
    warn "Keine Fritzbox-Verbindung konfiguriert — bitte zuerst einrichten."
    anykey
    ui_fritzbox || return 1
    load_fb || return 1
  fi
  if ! load_filter; then
    screen; title "◉ DNS Logging"
    info "Noch kein Gerätefilter definiert — bitte Geräte auswählen."
    anykey
    ui_devices || { load_filter || return 1; }
  fi
  screen; title "◉ DNS Logging"
  step "Login und Geräteliste (parallel)"
  fb_login_raw > "$TMPD/sid" &
  local p1=$!
  fetch_devices "$TMPD/dev.tsv" &
  local p2=$! dev_ok=1
  wait "$p1" 2>/dev/null
  wait "$p2" 2>/dev/null || dev_ok=0
  SID=$(<"$TMPD/sid")
  if [[ -z $SID || $SID == "0000000000000000" ]]; then
    step_fail "Login fehlgeschlagen — Zugangsdaten prüfen (BlockTime beachten!)"
    anykey; return 1
  fi
  step_ok "Login an $FB_IP erfolgreich"
  if ((dev_ok)); then load_devices "$TMPD/dev.tsv"; step_ok "$DEV_COUNT Geräte für die Namensauflösung"
  else warn "⚠  Geräteliste nicht ladbar — Gerätenamen können fehlen."; fi
  step "Beende verwaiste Aufzeichnungen"
  capture_stopall
  step_ok "Aufzeichnung auf ${CAPTURE_IFACE} bereit"

  FILTER_ON=1; BLOCK_ON=0; TG_ON=0; PAUSED=0; WEB_ON=0
  LOG_BUF=(); LOG_OFF=0; LOG_NEW=0; SHOWN=0
  RECONNECT=0; BACKOFF=2; BUCKETS=(); CUR_BUCKET=0
  TODAY=$(date +%F)
  load_blocklist || true
  load_tg || true
  local ev
  while true; do
    session_start
    view_setup
    msg "Logging läuft — ↑/↓/Mausrad scrollen · p Pause"
    ui_loop
    ev=$EVENT
    session_stop
    view_teardown
    case $ev in
      e) ui_devices && { load_filter; FILTER_ON=1; } ;;
      t) ui_telegram; if load_tg; then TG_ON=1; else TG_ON=0; fi ;;
      *) capture_stopall; return 0 ;;
    esac
  done
}

# ---------- Menüpunkt 5: Sperrliste anzeigen ----------
ui_blocklist() {
  screen; title "⊘ Sperrliste"
  if [[ ! -f $BLOCKLIST_FILE ]]; then
    blocklist_help; anykey "Taste = zurück zum Hauptmenü"; return 0
  fi
  local -a lines=()
  local l truncated=0
  while IFS= read -r l || [[ -n $l ]]; do
    if ((${#lines[@]} >= BLOCKLIST_MAX_LINES)); then truncated=1; break; fi
    lines+=("$l")
  done < "$BLOCKLIST_FILE"
  local total=${#lines[@]}
  if ((total == 0)); then warn "(Datei ist leer)"; anykey "Taste = zurück zum Hauptmenü"; return 0; fi
  local top h off=0 i idx max_off footer num
  top=$((HDR_ROWS + 3)); h=$((ROWS - top - 1)); ((h < 1)) && h=1
  printf '\033[%d;1H\033[2K  %s%s%s' "$((HDR_ROWS + 1))" "$C_OVERLAY" "$BLOCKLIST_FILE" "$C_RESET"
  printf '\033[?25l\033[?1000h\033[?1006h'
  while true; do
    for ((i = 0; i < h; i++)); do
      idx=$((off + i))
      printf '\033[%d;1H\033[2K' $((top + i))
      if ((idx < total)); then
        l=${lines[idx]}
        if [[ $l == \#* || -z ${l//[[:space:]]/} ]]; then
          printf '  %s%4d  %s%s' "$C_OVERLAY" $((idx + 1)) "$l" "$C_RESET"
        else
          printf '  %s%4d%s  %s%s%s' "$C_MAUVE" $((idx + 1)) "$C_RESET" "$C_TEXT" "$l" "$C_RESET"
        fi
      fi
    done
    footer="↑/↓ PgUp/PgDn Home/Ende scrollen · q = zurück · $total Zeilen"
    ((truncated == 1)) && footer+=" · ⚠ auf $BLOCKLIST_MAX_LINES begrenzt (lauschbox.env)"
    printf '\033[%d;1H\033[2K  %s%s%s' "$ROWS" "$C_OVERLAY" "$footer" "$C_RESET"
    read_key || break
    case $R_KEY in
      UP) off=$((off - 1)) ;;   DOWN) off=$((off + 1)) ;;
      PGUP) off=$((off - h)) ;; PGDN) off=$((off + h)) ;;
      HOME) off=0 ;;            END) off=$((total - h)) ;;
      WUP) off=$((off - 3)) ;;  WDN) off=$((off + 3)) ;;
      ESC|q|x|"") break ;;
    esac
    max_off=$((total - h)); ((max_off < 0)) && max_off=0
    ((off < 0)) && off=0
    ((off > max_off)) && off=$max_off
  done
  printf '\033[?25h\033[?1000l\033[?1006l'
}

# ---------- Menüpunkt 6: Statistik ----------
ui_stats() {
  screen; title "▤ Statistik (diese Sitzung)"
  if [[ ! -s $STATS ]]; then
    info "Noch keine Daten — starte zuerst DNS Logging."
    anykey "Taste = zurück zum Hauptmenü"; return 0
  fi
  local total hits topn c n max bar w
  total=$(wc -l < "$STATS" | tr -d ' ')
  hits=$(awk -F'\t' '$3 == 1' "$STATS" | wc -l | tr -d ' ')
  printf '  %s%s%s Anfragen · %s%s%s Treffer · %s%s%s Geräte · %s%s%s Domains\n' \
    "$C_TEXT" "$total" "$C_OVERLAY" "$C_RED" "$hits" "$C_OVERLAY" \
    "$C_SKY" "$(cut -f1 "$STATS" | sort -u | wc -l | tr -d ' ')" "$C_OVERLAY" \
    "$C_BLUE" "$(cut -f2 "$STATS" | sort -u | wc -l | tr -d ' ')" "$C_RESET"
  topn=$(((ROWS - HDR_ROWS - 12) / 3)); ((topn < 3)) && topn=3; ((topn > 8)) && topn=8
  w=$((COLS / 4)); ((w > 30)) && w=30; ((w < 6)) && w=6
  local sect col color label filt
  for sect in "2:Top Domains:$C_BLUE:all" "1:Aktivste Geräte:$C_SKY:all" "2:Sperrlisten-Treffer:$C_RED:hit"; do
    IFS=: read -r col label color filt <<< "$sect"
    printf '\n  %s%s%s\n' "$C_MAUVE" "$label" "$C_RESET"
    max=0
    local out
    if [[ $filt == hit ]]; then
      out=$(awk -F'\t' '$3 == 1 { print $2 }' "$STATS" | sort | uniq -c | sort -rn | head -n "$topn")
    else
      out=$(cut -f"$col" "$STATS" | sort | uniq -c | sort -rn | head -n "$topn")
    fi
    if [[ -z $out ]]; then printf '  %s—%s\n' "$C_OVERLAY" "$C_RESET"; continue; fi
    while read -r c n; do
      ((max == 0)) && max=$c
      bar=$(rep "█" $(( (c * w + max - 1) / max )))
      printf '  %s%6d%s %s%s%s %s%s%s\n' "$C_TEXT" "$c" "$C_RESET" "$color" "$bar" "$C_RESET" "$C_TEXT" "${n:0:$((COLS - w - 14))}" "$C_RESET"
    done <<< "$out"
  done
  anykey "Taste = zurück zum Hauptmenü"
}

# ---------- Menüpunkt 7: Logdatei Pfad ----------
ui_logpath() {
  local p
  screen
  title "✎ Logdatei Pfad"
  info "ℹ  Aktuell:  $LOG_FILE"
  info "   Standard:  $LOG_FILE_DEFAULT"
  info "   Gilt für das Datei-Log (Taste l im Logging). Gespeichert in $ENV_MAIN."
  echo
  ask p "${C_TEXT}Neuer Pfad (absolut, ~ erlaubt) — leer = Standard${C_RESET}"
  [[ $p == "~/"* ]] && p="$HOME/${p#\~/}"
  if [[ -z $p ]]; then
    set_env_key "$ENV_MAIN" LOG_FILE "" || { err "✖ Konnte $ENV_MAIN nicht schreiben"; anykey; return 1; }
    LOG_FILE="$LOG_FILE_DEFAULT"
    echo; ok "✔ Standard wiederhergestellt: $LOG_FILE"
  elif [[ $p != /* ]]; then
    echo; err "✖ Bitte einen absoluten Pfad angeben."; anykey; return 1
  elif [[ -d $p ]]; then
    echo; err "✖ $p ist ein Verzeichnis."; anykey; return 1
  else
    if ! { mkdir -p "$(dirname "$p")" && : >> "$p"; } 2>/dev/null; then
      echo; err "✖ $p nicht beschreibbar"; anykey; return 1
    fi
    set_env_key "$ENV_MAIN" LOG_FILE "$p" || { err "✖ Konnte $ENV_MAIN nicht schreiben"; anykey; return 1; }
    LOG_FILE=$p
    echo; ok "✔ Gespeichert: $LOG_FILE"
  fi
  anykey
  return 0
}

# ---------- Menüpunkt 8: Web-UI Einstellungen ----------
ui_websettings() {
  local p u pw h
  screen
  title "◈ Web-UI Einstellungen"
  info "ℹ  Port:      $WEB_PORT  (Standard 8080, erlaubt: 1024-65535)"
  if [[ -n $WEB_USER && -n $WEB_PASS ]]; then info "   Login:     Benutzer „${WEB_USER}“, Passwort gesetzt"
  else info "   Login:     keiner — Web-UI ist offen"; fi
  if [[ -n $WEB_HTML ]]; then info "   Seite:     $WEB_HTML  (eigener Pfad)"
  elif web_html_path; then info "   Seite:     $R_LINE  (Standard-Suche)"
  else info "   Seite:     keine web.html gefunden (./web.html oder $CONFIG_DIR/web.html)"; fi
  info "   Web-UI einschalten: Taste w im Logging. Gespeichert in $ENV_MAIN."
  echo
  ask p "${C_TEXT}Neuer Port — leer = unverändert${C_RESET}"
  if [[ -n $p ]]; then
    if [[ ! $p =~ ^[0-9]+$ ]] || ((10#$p < 1024 || 10#$p > 65535)); then
      echo; err "✖ Ungültiger Port (1024-65535)."; anykey; return 1
    fi
    p=$((10#$p))
  fi
  echo
  ask u "${C_TEXT}Benutzername — leer = kein Login (Web-UI offen)${C_RESET}"
  pw=""
  if [[ $u == *:* ]]; then
    echo; err "✖ Benutzername darf kein ':' enthalten."; anykey; return 1
  fi
  if [[ -n $u ]]; then
    echo
    ask pw "${C_TEXT}Passwort — leer = kein Login (Web-UI offen)${C_RESET}" secret
  fi
  echo
  ask h "${C_TEXT}Pfad zur web.html (absolut, ~ erlaubt) — leer = Standard (./web.html, dann $CONFIG_DIR/web.html)${C_RESET}"
  [[ $h == "~/"* ]] && h="$HOME/${h#\~/}"
  if [[ -n $h ]]; then
    if [[ $h != /* ]]; then echo; err "✖ Bitte einen absoluten Pfad angeben."; anykey; return 1; fi
    if [[ ! -f $h || ! -r $h ]]; then echo; err "✖ $h ist keine lesbare Datei."; anykey; return 1; fi
  fi
  [[ -n $p ]] && { set_env_key "$ENV_MAIN" WEB_PORT "$p" || { err "✖ Konnte $ENV_MAIN nicht schreiben"; anykey; return 1; }; WEB_PORT=$p; }
  if [[ -z $u || -z $pw ]]; then u=""; pw=""; fi
  set_env_key "$ENV_MAIN" WEB_HTML "$h" || { err "✖ Konnte $ENV_MAIN nicht schreiben"; anykey; return 1; }
  WEB_HTML=$h
  set_env_key "$ENV_MAIN" WEB_USER "$u" && set_env_key "$ENV_MAIN" WEB_PASS "$pw" \
    || { err "✖ Konnte $ENV_MAIN nicht schreiben"; anykey; return 1; }
  WEB_USER=$u; WEB_PASS=$pw
  echo; ok "✔ Gespeichert: Port $WEB_PORT"
  if [[ -n $WEB_USER ]]; then ok "✔ Login aktiv für Benutzer „${WEB_USER}“"
  else warn "⚠ Kein Login gesetzt — die Web-UI ist offen (jeder im Netz hat Zugriff)."; fi
  if [[ -n $WEB_HTML ]]; then ok "✔ Eigene Seite: $WEB_HTML"
  else warn "ℹ Kein Pfad gesetzt — Standard: ./web.html, dann $CONFIG_DIR/web.html (WEB_HTML bleibt in der env auskommentiert/leer)."; fi
  warn "  $ENV_MAIN enthält das Passwort im Klartext (Rechte 600)."
  anykey
  return 0
}

# ---------- Hauptmenü ----------
MENU_ICONS=("⇄" "➤" "▣" "◉" "⊘" "▤" "✎" "◈" "✕")  # einspaltige Symbole, in Mauve gezeichnet
MENU_LABELS=("Verbindung Fritzbox" "Verbindung Telegram" "Gerätefilter" "DNS Logging" "Sperrliste anzeigen" "Statistik" "Logdatei Pfad" "Web-UI Einstellungen" "Ende")

menu_dashboard() {  # Statuszeilen
  local fbs tgs fs bls lfs
  if load_fb; then fbs="${C_GREEN}● ${C_TEXT}$FB_IP ${C_OVERLAY}($FB_USER)"; else fbs="${C_RED}○ ${C_OVERLAY}nicht konfiguriert"; fi
  if load_tg; then tgs="${C_GREEN}● ${C_TEXT}konfiguriert"; else tgs="${C_RED}○ ${C_OVERLAY}nicht konfiguriert"; fi
  if load_filter; then fs="${C_SKY}${DEVICE_FILTER_NAMES}"; else fs="${C_OVERLAY}noch nicht gewählt"; fi
  if load_blocklist; then bls="${C_GREEN}● ${C_TEXT}${BL_COUNT} Domains"; else bls="${C_RED}○ ${C_OVERLAY}keine blocklist.txt"; fi
  if [[ $LOG_FILE == "$LOG_FILE_DEFAULT" ]]; then lfs="${C_TEXT}${LOG_FILE/#$HOME/~} ${C_OVERLAY}(Standard)"; else lfs="${C_TEXT}${LOG_FILE/#$HOME/~}"; fi
  DASH_1="  ${C_OVERLAY}Fritzbox    $fbs"
  DASH_2="  ${C_OVERLAY}Telegram    $tgs"
  DASH_3="  ${C_OVERLAY}Filter      $fs"
  DASH_4="  ${C_OVERLAY}Sperrliste  $bls"
  DASH_5="  ${C_OVERLAY}Logdatei    $lfs"
  DASH_6="  ${C_OVERLAY}Web-UI      ${C_TEXT}http://$(hostname):$WEB_PORT"
}

menu_draw() {  # menu_draw AUSWAHL
  local i n=${#MENU_LABELS[@]} row=$((HDR_ROWS + 1))
  printf '\033[%d;1H' "$row"
  printf '%s\033[K%s\n%s\033[K%s\n%s\033[K%s\n%s\033[K%s\n%s\033[K%s\n%s\033[K%s\n\033[K\n' \
    "$DASH_1" "$C_RESET" "$DASH_2" "$C_RESET" "$DASH_3" "$C_RESET" "$DASH_4" "$C_RESET" "$DASH_5" "$C_RESET" "$DASH_6" "$C_RESET"
  for ((i = 0; i < n; i++)); do
    if ((i == $1)); then
      printf '  %s%s ▸ %s%d%s  %s%s%s  %s%s\033[K%s\n' "$C_SEL" "$C_MAUVE" "$C_BOLD" "$((i + 1))" "$C_NOBOLD" "$C_MAUVE" "${MENU_ICONS[i]}" "$C_TEXT" "$C_TEXT" "${MENU_LABELS[i]}" "$C_RESET"
    else
      printf '  %s   %d%s  %s%s%s  %s%s\033[K\n' "$C_OVERLAY" "$((i + 1))" "$C_RESET" "$C_MAUVE" "${MENU_ICONS[i]}" "$C_TEXT" "$C_TEXT" "${MENU_LABELS[i]}"
    fi
  done
  printf '%s\033[K\n  %s↑/↓ wählen · Enter öffnen · 1-%d direkt · q Ende%s\033[K' "$C_RESET" "$C_OVERLAY" "$n" "$C_RESET"
}

menu_run() {
  printf '\033[?1000l\033[?1006l'
  case $1 in
    0) ui_fritzbox ;;
    1) ui_telegram ;;
    2) ui_devices ;;
    3) ui_logging ;;
    4) ui_blocklist ;;
    5) ui_stats ;;
    6) ui_logpath ;;
    7) ui_websettings ;;
    8) exit 0 ;;
  esac
  return 0
}

main_menu() {
  local sel=0 n=${#MENU_LABELS[@]} redraw=1
  load_fb && sel=3
  while true; do
    if ((redraw)); then screen; menu_dashboard; redraw=0; fi
    menu_draw "$sel"
    read_key || exit 0
    case $R_KEY in
      UP)   sel=$(((sel + n - 1) % n)) ;;
      DOWN) sel=$(((sel + 1) % n)) ;;
      HOME) sel=0 ;;
      END)  sel=$((n - 1)) ;;
      [1-9]) if ((R_KEY <= n)); then sel=$((R_KEY - 1)); menu_run "$sel"; redraw=1; fi ;;
      "")   menu_run "$sel"; redraw=1 ;;
      q)    exit 0 ;;
    esac
  done
}

