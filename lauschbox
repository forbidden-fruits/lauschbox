  [[ -z $TG_TOKEN ]] && { warn "Abgebrochen — kein Token eingegeben."; anykey; return 1; }
  echo
  info "ℹ️  Chat-ID: @userinfobot anschreiben — oder dem Bot schreiben und"
  info "   https://api.telegram.org/bot<TOKEN>/getUpdates → result[].message.chat.id."
  info "   Gruppen haben negative IDs (Bot muss Mitglied sein)."
  ask TG_CHAT_ID "${C_TEXT}Chat-ID${C_RESET}"
  [[ -z $TG_CHAT_ID ]] && { warn "Abgebrochen — keine Chat-ID eingegeben."; anykey; return 1; }
  save_tg
  echo
  ok "✔ Gespeichert in $ENV_TG"
  step "Sende Testnachricht"
  if tg_test; then step_ok "Testnachricht zugestellt"
  else step_fail "Telegram lehnt ab: $R_NAME"; fi
  anykey
  return 0
}

# ---------- Menüpunkt 3: Gerätefilter (Checkbox-Liste) ----------
ui_devices() {
  if ! load_fb; then
    screen; title "📱 Gerätefilter"
    warn "Keine Fritzbox-Verbindung konfiguriert — bitte zuerst einrichten."
    anykey
    ui_fritzbox || return 1
    load_fb || return 1
  fi
  screen; title "📱 Gerätefilter"
  step "Lade Geräteliste von $FB_IP"
  if ! fetch_devices "$TMPD/dev.tsv"; then
    step_fail "Geräteliste nicht ladbar (Zugangsdaten / TR-064 prüfen)"
    anykey; return 1
  fi
  load_devices "$TMPD/dev.tsv"
  if ((DEV_COUNT == 0)); then step_fail "Keine Geräte gefunden"; anykey; return 1; fi
  step_ok "$DEV_COUNT Geräte geladen"

  local -a chk=()
  local i cur=0 off=0 top h nsel k icon line nm dot cb mark ipd
  load_filter || true
  for ((i = 0; i < DEV_COUNT; i++)); do
    chk[i]=0
    [[ $DEVICE_FILTER != ALL && ,$DEVICE_FILTER, == *",${DEV_MAC[i]},"* ]] && chk[i]=1
  done
  layout
  top=$((HDR_ROWS + 4)); h=$((ROWS - top - 1)); ((h < 3)) && h=3
  printf '\033[%d;1H\033[2K  %sLeertaste%s wählen · %sa%s alle Geräte · %sn%s keine · %sEnter%s speichern · %sq%s abbrechen' \
    "$((HDR_ROWS + 3))" "$C_MAUVE" "$C_OVERLAY" "$C_MAUVE" "$C_OVERLAY" "$C_MAUVE" "$C_OVERLAY" "$C_MAUVE" "$C_OVERLAY" "$C_MAUVE" "$C_OVERLAY"
  printf '\033[?25l\033[?1000h\033[?1006h'
  while true; do
    ((cur < off)) && off=$cur
    ((cur >= off + h)) && off=$((cur - h + 1))
    nsel=0; for ((i = 0; i < DEV_COUNT; i++)); do ((chk[i])) && nsel=$((nsel + 1)); done
    for ((i = 0; i < h; i++)); do
      k=$((off + i))
      printf '\033[%d;1H\033[2K' $((top + i))
      ((k < DEV_COUNT)) || continue
      icon='🔗'
      case ${DEV_IF[k]} in 802.11) icon='📶' ;; Ethernet) icon='🔌' ;; esac
      [[ ${DEV_GUEST[k]} == 1 ]] && icon='👥'
      nm=${DEV_NAME[k]:-(ohne Namen)}
      ((${#nm} > 26)) && nm="${nm:0:25}…"
      if [[ ${DEV_ACT[k]} == 1 ]]; then dot="${C_GREEN}●"; else dot="${C_OVERLAY}○"; fi
      if ((chk[k])); then cb="${C_GREEN}[✔]"; else cb="${C_OVERLAY}[ ]"; fi
      if ((k == cur)); then mark="${C_SEL}${C_MAUVE}▸"; else mark=" "; fi
      line="$mark $cb $dot $icon "
      if [[ ${DEV_ACT[k]} == 1 ]]; then line+="${C_SKY}"; else line+="${C_OVERLAY}"; fi
      ipd=${DEV_IP[k]:--}
      line+="$nm${SPACES:0:$((26 - ${#nm}))} ${C_BLUE}${ipd}${SPACES:0:$((15 - ${#ipd}))} ${C_OVERLAY}${DEV_MAC[k]}"
      printf '  %s' "$line"
      ((k == cur)) && printf '\033[K'
      printf '%s' "$C_RESET"
    done
    printf '\033[%d;1H\033[2K  %s%d von %d ausgewählt%s' "$ROWS" "$C_OVERLAY" "$nsel" "$DEV_COUNT" "$C_RESET"
    ((nsel == 0)) && printf '%s — ohne Auswahl: Alle Netzwerkgeräte%s' "$C_OVERLAY" "$C_RESET"
    ((DEV_COUNT > h)) && printf '%s · ↑/↓ PgUp/PgDn scrollen%s' "$C_OVERLAY" "$C_RESET"
    read_key || break
    case $R_KEY in
      UP)   cur=$((cur - 1)) ;;
      DOWN) cur=$((cur + 1)) ;;
      PGUP) cur=$((cur - h)) ;;
      PGDN) cur=$((cur + h)) ;;
      HOME) cur=0 ;;
      END)  cur=$((DEV_COUNT - 1)) ;;
      WUP)  cur=$((cur - 3)) ;;
      WDN)  cur=$((cur + 3)) ;;
      " ")  chk[cur]=$((1 - chk[cur])) ;;
      a)    for ((i = 0; i < DEV_COUNT; i++)); do chk[i]=0; done; nsel=0; break ;;
      n)    for ((i = 0; i < DEV_COUNT; i++)); do chk[i]=0; done ;;
      "")   break ;;
      q|ESC)
        printf '\033[?25h\033[?1000l\033[?1006l'
        return 1 ;;
    esac
    ((cur < 0)) && cur=0
    ((cur >= DEV_COUNT)) && cur=$((DEV_COUNT - 1))
  done
  printf '\033[?25h\033[?1000l\033[?1006l'
  local macs="" names=""
  nsel=0
  for ((i = 0; i < DEV_COUNT; i++)); do
    if ((chk[i])); then
      macs+="${macs:+,}${DEV_MAC[i]}"
      names+="${names:+, }${DEV_NAME[i]:-${DEV_MAC[i]}}"
      nsel=$((nsel + 1))
    fi
  done
  if ((nsel == 0)); then DEVICE_FILTER="ALL"; DEVICE_FILTER_NAMES="Alle Netzwerkgeräte"
  else DEVICE_FILTER=$macs; DEVICE_FILTER_NAMES=$names; fi
  save_filter
  printf '\033[%d;1H\033[2K  %s✔ Gerätefilter gespeichert: %s%s' "$ROWS" "$C_GREEN" "$DEVICE_FILTER_NAMES" "$C_RESET"
  sleep 1
  return 0
}

# ---------- Menüpunkt 4: DNS Logging ----------
ui_logging() {
  if ! load_fb; then
    screen; title "📡 DNS Logging"
    warn "Keine Fritzbox-Verbindung konfiguriert — bitte zuerst einrichten."
    anykey
    ui_fritzbox || return 1
    load_fb || return 1
  fi
  if ! load_filter; then
    screen; title "📡 DNS Logging"
    info "Noch kein Gerätefilter definiert — bitte Geräte auswählen."
    anykey
    ui_devices || { load_filter || return 1; }
  fi
  screen; title "📡 DNS Logging"
  step "Login und Geräteliste (parallel)"
  fb_login_raw > "$TMPD/sid" &
  local p1=$!
  fetch_devices "$TMPD/dev.tsv" &
  local p2=$! dev_ok=1
  wait "$p1" 2>/dev/null
  wait "$p2" 2>/dev/null || dev_ok=0
  SID=$(<"$TMPD/sid")
  if [[ -z $SID || $SID == "0000000000000000" ]]; then
    step_fail "Login fehlgeschlagen — Zugangsdaten prüfen (BlockTime beachten!)"
    anykey; return 1
  fi
  step_ok "Login an $FB_IP erfolgreich"
  if ((dev_ok)); then load_devices "$TMPD/dev.tsv"; step_ok "$DEV_COUNT Geräte für die Namensauflösung"
  else warn "⚠️  Geräteliste nicht ladbar — Gerätenamen können fehlen."; fi
  step "Beende verwaiste Aufzeichnungen"
  capture_stopall
  step_ok "Aufzeichnung auf ${CAPTURE_IFACE} bereit"

  FILTER_ON=1; BLOCK_ON=0; TG_ON=0; PAUSED=0
  LOG_BUF=(); LOG_OFF=0; LOG_NEW=0; SHOWN=0
  RECONNECT=0; BACKOFF=2; BUCKETS=(); CUR_BUCKET=0
  TODAY=$(date +%F)
  load_blocklist || true
  load_tg || true
  local ev
  while true; do
    session_start
    view_setup
    msg "Logging läuft — ↑/↓/Mausrad scrollen · p Pause"
    ui_loop
    ev=$EVENT
    session_stop
    view_teardown
    case $ev in
      e) ui_devices && { load_filter; FILTER_ON=1; } ;;
      t) ui_telegram; if load_tg; then TG_ON=1; else TG_ON=0; fi ;;
      *) capture_stopall; return 0 ;;
    esac
  done
}

# ---------- Menüpunkt 5: Sperrliste anzeigen ----------
ui_blocklist() {
  screen; title "🚫 Sperrliste"
  if [[ ! -f $BLOCKLIST_FILE ]]; then
    blocklist_help; anykey "Taste = zurück zum Hauptmenü"; return 0
  fi
  local -a lines=()
  local l truncated=0
  while IFS= read -r l || [[ -n $l ]]; do
    if ((${#lines[@]} >= BLOCKLIST_MAX_LINES)); then truncated=1; break; fi
    lines+=("$l")
  done < "$BLOCKLIST_FILE"
  local total=${#lines[@]}
  if ((total == 0)); then warn "(Datei ist leer)"; anykey "Taste = zurück zum Hauptmenü"; return 0; fi
  local top h off=0 i idx max_off footer num
  top=$((HDR_ROWS + 3)); h=$((ROWS - top - 1)); ((h < 1)) && h=1
  printf '\033[%d;1H\033[2K  %s%s%s' "$((HDR_ROWS + 1))" "$C_OVERLAY" "$BLOCKLIST_FILE" "$C_RESET"
  printf '\033[?25l\033[?1000h\033[?1006h'
  while true; do
    for ((i = 0; i < h; i++)); do
      idx=$((off + i))
      printf '\033[%d;1H\033[2K' $((top + i))
      if ((idx < total)); then
        l=${lines[idx]}
        if [[ $l == \#* || -z ${l//[[:space:]]/} ]]; then
          printf '  %s%4d  %s%s' "$C_OVERLAY" $((idx + 1)) "$l" "$C_RESET"
        else
          printf '  %s%4d%s  %s%s%s' "$C_MAUVE" $((idx + 1)) "$C_RESET" "$C_TEXT" "$l" "$C_RESET"
        fi
      fi
    done
    footer="↑/↓ PgUp/PgDn Home/Ende scrollen · q = zurück · $total Zeilen"
    ((truncated == 1)) && footer+=" · ⚠️ auf $BLOCKLIST_MAX_LINES begrenzt (lauschbox.env)"
    printf '\033[%d;1H\033[2K  %s%s%s' "$ROWS" "$C_OVERLAY" "$footer" "$C_RESET"
    read_key || break
    case $R_KEY in
      UP) off=$((off - 1)) ;;   DOWN) off=$((off + 1)) ;;
      PGUP) off=$((off - h)) ;; PGDN) off=$((off + h)) ;;
      HOME) off=0 ;;            END) off=$((total - h)) ;;
      WUP) off=$((off - 3)) ;;  WDN) off=$((off + 3)) ;;
      ESC|q|x|"") break ;;
    esac
    max_off=$((total - h)); ((max_off < 0)) && max_off=0
    ((off < 0)) && off=0
    ((off > max_off)) && off=$max_off
  done
  printf '\033[?25h\033[?1000l\033[?1006l'
}

# ---------- Menüpunkt 6: Statistik ----------
ui_stats() {
  screen; title "📊 Statistik (diese Sitzung)"
  if [[ ! -s $STATS ]]; then
    info "Noch keine Daten — starte zuerst DNS Logging."
    anykey "Taste = zurück zum Hauptmenü"; return 0
  fi
  local total hits topn c n max bar w
  total=$(wc -l < "$STATS" | tr -d ' ')
  hits=$(awk -F'\t' '$3 == 1' "$STATS" | wc -l | tr -d ' ')
  printf '  %s%s%s Anfragen · %s%s%s Treffer · %s%s%s Geräte · %s%s%s Domains\n' \
    "$C_TEXT" "$total" "$C_OVERLAY" "$C_RED" "$hits" "$C_OVERLAY" \
    "$C_SKY" "$(cut -f1 "$STATS" | sort -u | wc -l | tr -d ' ')" "$C_OVERLAY" \
    "$C_BLUE" "$(cut -f2 "$STATS" | sort -u | wc -l | tr -d ' ')" "$C_RESET"
  topn=$(((ROWS - HDR_ROWS - 12) / 3)); ((topn < 3)) && topn=3; ((topn > 8)) && topn=8
  w=$((COLS / 4)); ((w > 30)) && w=30; ((w < 6)) && w=6
  local sect col color label filt
  for sect in "2:Top Domains:$C_BLUE:all" "1:Aktivste Geräte:$C_SKY:all" "2:Sperrlisten-Treffer:$C_RED:hit"; do
    IFS=: read -r col label color filt <<< "$sect"
    printf '\n  %s%s%s\n' "$C_MAUVE" "$label" "$C_RESET"
    max=0
    local out
    if [[ $filt == hit ]]; then
      out=$(awk -F'\t' '$3 == 1 { print $2 }' "$STATS" | sort | uniq -c | sort -rn | head -n "$topn")
    else
      out=$(cut -f"$col" "$STATS" | sort | uniq -c | sort -rn | head -n "$topn")
    fi
    if [[ -z $out ]]; then printf '  %s—%s\n' "$C_OVERLAY" "$C_RESET"; continue; fi
    while read -r c n; do
      ((max == 0)) && max=$c
      bar=$(rep "█" $(( (c * w + max - 1) / max )))
      printf '  %s%6d%s %s%s%s %s%s%s\n' "$C_TEXT" "$c" "$C_RESET" "$color" "$bar" "$C_RESET" "$C_TEXT" "${n:0:$((COLS - w - 14))}" "$C_RESET"
    done <<< "$out"
  done
  anykey "Taste = zurück zum Hauptmenü"
}

# ---------- Menüpunkt 7: Logdatei Pfad ----------
ui_logpath() {
  local p
  screen
  title "📝 Logdatei Pfad"
  info "ℹ️  Aktuell:  $LOG_FILE"
  info "   Standard:  $LOG_FILE_DEFAULT"
  info "   Gilt für das Datei-Log (Taste l im Logging). Gespeichert in $ENV_MAIN."
  echo
  ask p "${C_TEXT}Neuer Pfad (absolut, ~ erlaubt) — leer = Standard${C_RESET}"
  [[ $p == "~/"* ]] && p="$HOME/${p#\~/}"
  if [[ -z $p ]]; then
    set_env_key "$ENV_MAIN" LOG_FILE "" || { err "✖ Konnte $ENV_MAIN nicht schreiben"; anykey; return 1; }
    LOG_FILE="$LOG_FILE_DEFAULT"
    echo; ok "✔ Standard wiederhergestellt: $LOG_FILE"
  elif [[ $p != /* ]]; then
    echo; err "✖ Bitte einen absoluten Pfad angeben."; anykey; return 1
  elif [[ -d $p ]]; then
    echo; err "✖ $p ist ein Verzeichnis."; anykey; return 1
  else
    if ! { mkdir -p "$(dirname "$p")" && : >> "$p"; } 2>/dev/null; then
      echo; err "✖ $p nicht beschreibbar"; anykey; return 1
    fi
    set_env_key "$ENV_MAIN" LOG_FILE "$p" || { err "✖ Konnte $ENV_MAIN nicht schreiben"; anykey; return 1; }
    LOG_FILE=$p
    echo; ok "✔ Gespeichert: $LOG_FILE"
  fi
  anykey
  return 0
}

