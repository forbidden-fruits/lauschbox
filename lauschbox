# ---------- Abhängigkeiten ----------
check_deps() {
  local missing=() t
  for t in curl tshark python3; do
    command -v "$t" >/dev/null 2>&1 || missing+=("$t")
  done
  ((${#missing[@]} == 0)) && return 0
  local brew_pkgs=() apt_pkgs=()
  for t in "${missing[@]}"; do
    case $t in
      tshark)  brew_pkgs+=("wireshark"); apt_pkgs+=("tshark") ;;
      python3) brew_pkgs+=("python");    apt_pkgs+=("python3") ;;
      *)       brew_pkgs+=("$t");        apt_pkgs+=("$t") ;;
    esac
  done
  printf '%s❌ Fehlende Werkzeuge: %s%s\n\n' "$C_RED" "${missing[*]}" "$C_RESET"
  if [[ $(uname -s) == Darwin ]]; then
    printf 'Installation mit Homebrew:\n  %sbrew install %s%s\n' "$C_TEAL" "${brew_pkgs[*]}" "$C_RESET"
  else
    printf 'Installation mit apt-get:\n  %ssudo apt-get install %s%s\n' "$C_TEAL" "${apt_pkgs[*]}" "$C_RESET"
  fi
  exit 1
}

# ---------- Layout, Banner (Farbverlauf), Kopfzeile ----------
lerp() { printf '%d' $(( $1 + ($2 - $1) * $3 / $4 )); }  # von bis i n

build_banner() {  # figlet (optional) → BANNER_TXT mit vertikalem Farbverlauf
  BANNER_TXT=""; BANNER_ROWS=0
  command -v figlet >/dev/null 2>&1 || return 0
  local art line i=0 n r g b
  local -a lines=()
  art=$(figlet lauschbox 2>/dev/null) || return 0
  while IFS= read -r line; do
    [[ -z ${line//[[:space:]]/} ]] && continue
    lines+=("$line")
  done <<< "$art"
  n=${#lines[@]}
  ((n > 0)) || return 0
  for line in "${lines[@]}"; do
    if [[ -n ${NO_COLOR:-} ]]; then
      BANNER_TXT+="$line$NL"
    else
      r=$(lerp 198 145 $i $((n > 1 ? n - 1 : 1)))
      g=$(lerp 160 215 $i $((n > 1 ? n - 1 : 1)))
      b=$(lerp 246 227 $i $((n > 1 ? n - 1 : 1)))
      BANNER_TXT+="$(printf '\033[38;2;%d;%d;%dm' "$r" "$g" "$b")$line$C_RESET$NL"
    fi
    i=$((i + 1))
  done
  BANNER_ROWS=$n
}

layout() {  # Terminalgröße + Kopfzeilen-Modus neu bestimmen
  local sz
  sz=$(stty size 2>/dev/null </dev/tty) || sz=""
  if [[ $sz =~ ^([0-9]+)\ ([0-9]+)$ ]]; then
    ROWS=${BASH_REMATCH[1]}; COLS=${BASH_REMATCH[2]}
  else
    ROWS=24; COLS=80
  fi
  if ((BANNER_ROWS == 0 || ROWS < 30 || COLS < 50)); then
    COMPACT=1; HDR_ROWS=2
  else
    COMPACT=0; HDR_ROWS=$((BANNER_ROWS + 2))
  fi
  if ((COLS >= 100)); then NAME_W=18; else NAME_W=12; fi
}

header() {  # zeichnet HDR_ROWS Zeilen ab Zeile 1
  if ((COMPACT)); then
    printf ' %s%s▌ lauschbox%s %s· DNS-Lauscher für die FRITZ!Box · v%s%s\n\n' \
      "$C_MAUVE" "$C_BOLD" "$C_NOBOLD" "$C_OVERLAY" "$VERSION" "$C_RESET"
  else
    printf '%s' "$BANNER_TXT"
    printf ' %s DNS-Lauscher für die FRITZ!Box · v%s%s\n\n' "$C_OVERLAY" "$VERSION" "$C_RESET"
  fi
}

screen() { layout; printf '\033[r\033[H\033[2J'; header; }

rep() {  # rep ZEICHEN N → Ausgabe
  local s
  ((${2} > 0)) || return 0
  printf -v s '%*s' "$2" ''
  printf '%s' "${s// /$1}"
}

title() { printf '  %s%s%s%s\n\n' "$C_BOLD" "$C_MAUVE" "$1" "$C_RESET"; }
info()  { printf '  %s%s%s\n' "$C_OVERLAY" "$1" "$C_RESET"; }
ok()    { printf '  %s%s%s\n' "$C_GREEN" "$1" "$C_RESET"; }
warn()  { printf '  %s%s%s\n' "$C_YELLOW" "$1" "$C_RESET"; }
err()   { printf '  %s%s%s\n' "$C_RED" "$1" "$C_RESET"; }

ask() {  # ask VAR LABEL [secret]
  local __v=$1 __s=${3:-} val
  printf '  %b\n' "$2"
  printf '  %s❯%s ' "$C_TEAL" "$C_RESET"
  if [[ -n $__s ]]; then IFS= read -r -s val; echo; else IFS= read -r -e val; fi
  printf -v "$__v" '%s' "$val"
}

# Schritt-Anzeige: "  ⏳ text" → später zu ✔/✖ umschreiben
step()      { printf '  %s⏳ %s …%s' "$C_OVERLAY" "$1" "$C_RESET"; }
step_ok()   { printf '\r\033[2K  %s✔ %s%s\n' "$C_GREEN" "$1" "$C_RESET"; }
step_fail() { printf '\r\033[2K  %s✖ %s%s\n' "$C_RED" "$1" "$C_RESET"; }

# read_key: eine Taste inkl. Escape-Sequenzen → R_KEY:
# Zeichen | UP DOWN PGUP PGDN HOME END WUP WDN | ESC | NONE | "" (Enter). EOF → 1.
read_key() {
  R_KEY=""
  local k c seq=""
  IFS= read -r -s -n 1 k || return 1
  if [[ $k != $'\033' ]]; then R_KEY=$k; return 0; fi
  while IFS= read -r -s -n 1 -t 1 c; do
    seq+="$c"
    [[ $c =~ [A-Za-z~] ]] && break
  done
  case $seq in
    '[A'|'OA')             R_KEY=UP ;;
    '[B'|'OB')             R_KEY=DOWN ;;
    '[5~')                 R_KEY=PGUP ;;
    '[6~')                 R_KEY=PGDN ;;
    '[H'|'[1~'|'[7~'|'OH') R_KEY=HOME ;;
    '[F'|'[4~'|'[8~'|'OF') R_KEY=END ;;
    '[<64;'*)              R_KEY=WUP ;;
    '[<65;'*)              R_KEY=WDN ;;
    '')                    R_KEY=ESC ;;
    *)                     R_KEY=NONE ;;
  esac
  return 0
}

anykey() {
  printf '\n  %s%s%s' "$C_OVERLAY" "${1:-Taste drücken = weiter}" "$C_RESET"
  while read_key; do [[ $R_KEY != NONE && $R_KEY != WUP && $R_KEY != WDN ]] && break; done
}

confirm() {  # confirm TEXT → j/J = ja, alles andere nein
  printf '  %s⚠️  %s [j/N]%s ' "$C_YELLOW" "$1" "$C_RESET"
  local k=""
  IFS= read -r -s -n 1 k || return 1
  echo
  [[ $k == j ]]
}

# ---------- Konfigurationsdateien ----------
sq() { local s=${1//\'/\'\\\'\'}; printf "'%s'" "$s"; }

save_env() {  # save_env DATEI VAR...  (0600, atomar)
  local f=$1 v tmp
  shift
  mkdir -p "$(dirname "$f")"
  tmp=$(mktemp "$f.XXXXXX") || return 1
  for v in "$@"; do printf '%s=%s\n' "$v" "$(sq "${!v}")"; done > "$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}
save_fb()     { save_env "$ENV_FB" FB_IP FB_USER FB_PASS; }
save_tg()     { save_env "$ENV_TG" TG_TOKEN TG_CHAT_ID; }
save_filter() { save_env "$ENV_DEV" DEVICE_FILTER DEVICE_FILTER_NAMES; }

set_env_key() {  # set_env_key DATEI VAR WERT — ersetzt/ergänzt VAR, übrige Zeilen bleiben; WERT leer = entfernen
  local f=$1 k=$2 v=$3 line tmp re="^[[:space:]]*(export[[:space:]]+)?$2="
  mkdir -p "$(dirname "$f")"
  tmp=$(mktemp "$f.XXXXXX") || return 1
  {
    if [[ -f $f ]]; then
      while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ $re ]] || printf '%s\n' "$line"
      done < "$f"
    fi
    [[ -n $v ]] && printf '%s=%s\n' "$k" "$(sq "$v")"
  } > "$tmp"
  chmod 600 "$tmp"; mv -f "$tmp" "$f"
}

load_fb() {
