LOG_FILE="$LOG_FILE_DEFAULT"

# ---------- .env-Parser (führt nichts aus, nur Whitelist-Variablen) ----------
load_env() {  # load_env DATEI VAR...
  local f=$1 line k v re esc="'\\''"
  shift
  [[ -f $f ]] || return 1
  re='^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$'
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ $re ]] || continue
    k=${BASH_REMATCH[2]}; v=${BASH_REMATCH[3]}
    case " $* " in *" $k "*) ;; *) continue ;; esac
    v="${v#"${v%%[![:space:]]*}"}"
    if [[ $v == \'* ]]; then
      v=${v#\'}; v=${v%\'*}; v=${v//"$esc"/"'"}
    elif [[ $v == \"* ]]; then
      v=${v#\"}; v=${v%\"*}
      v=${v//\\\"/\"}; v=${v//\\\$/\$}; v=${v//\\\\/\\}
    else
      v=${v%%[[:space:]]#*}; v="${v%"${v##*[![:space:]]}"}"
    fi
    printf -v "$k" '%s' "$v"
  done < "$f"
  return 0
}
load_env "$ENV_MAIN" LOG_MAX_LINES BLOCKLIST_MAX_LINES CAPTURE_IFACE DEDUPE_SECS \
  NOTIFY_COOLDOWN DEVICE_REFRESH_SECS LOG_FILE WEB_PORT WEB_HTML WEB_USER WEB_PASS
_posint() { [[ ${!1} =~ ^[0-9]+$ ]] || printf -v "$1" '%s' "$2"; }
_posint LOG_MAX_LINES 1000; _posint BLOCKLIST_MAX_LINES 1000; _posint DEDUPE_SECS 2
_posint NOTIFY_COOLDOWN 30; _posint DEVICE_REFRESH_SECS 300
_posint WEB_PORT 8080; ((WEB_PORT >= 1024 && WEB_PORT <= 65535)) || WEB_PORT=8080
web_html_path() {  # → R_LINE: Prio 1 WEB_HTML (lauschbox.env), 2 $PWD/web.html, 3 ~/.config/lauschbox/web.html
