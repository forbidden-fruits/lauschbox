# ---------- Fritzbox: Login (SID) ----------
# Passwort läuft per Umgebung ins python-Kind — nie in argv (ps-sicher).
read -r -d '' PY_LOGIN <<'PY'
import sys, os, urllib.request, urllib.parse, hashlib
import xml.etree.ElementTree as ET
ip, user = sys.argv[1:3]
pw = os.environ.get("LB_PASS", "")
base = f"http://{ip}/login_sid.lua"

def rd(url, data=None):
    with urllib.request.urlopen(urllib.request.Request(url, data=data), timeout=8) as r:
        return ET.fromstring(r.read())

try:
    root = rd(base + "?version=2")
except Exception as e:
    print(f"Fehler: {e}", file=sys.stderr); sys.exit(1)

sid = root.findtext("SID") or ""
ch = root.findtext("Challenge") or ""
bt = root.findtext("BlockTime") or "0"
if bt != "0":
    print(f"BlockTime {bt}s aktiv (zu viele Fehlversuche)", file=sys.stderr)

if ch.startswith("2$"):
    try:
        _, it1, salt1, it2, salt2 = ch.split("$")
        h1 = hashlib.pbkdf2_hmac("sha256", pw.encode(), bytes.fromhex(salt1), int(it1))
        h2 = hashlib.pbkdf2_hmac("sha256", h1, bytes.fromhex(salt2), int(it2))
        post = urllib.parse.urlencode({"username": user, "response": f"{salt2}${h2.hex()}"}).encode()
        sid = rd(base + "?version=2", post).findtext("SID") or ""
    except Exception as e:
        print(f"Fehler (V2): {e}", file=sys.stderr)

if sid in ("", "0000000000000000"):
    try:
        root = rd(base)
        ch = root.findtext("Challenge") or ""
        h = hashlib.md5((ch + "-" + pw).encode("utf-16-le")).hexdigest()
        post = urllib.parse.urlencode({"username": user, "response": f"{ch}-{h}"}).encode()
        sid = rd(base, post).findtext("SID") or ""
    except Exception as e:
        print(f"Fehler (V1): {e}", file=sys.stderr)
print(sid)
PY

fb_login_raw() { LB_PASS="$FB_PASS" python3 -c "$PY_LOGIN" "$FB_IP" "$FB_USER" 2>/dev/null; }

fb_login() {
  SID=$(fb_login_raw)
  [[ -n $SID && $SID != "0000000000000000" ]]
}

# ---------- Fritzbox: Geräteliste (TR-064) ----------
# Bevorzugt X_AVM-DE_GetHostListPath: EIN Request für alle Hosts (statt einem
# SOAP-Call pro Gerät). Fallback: GetGenericHostEntry-Schleife (alte Firmware).
# Ausgabe pro Gerät: aktiv \x1f name \x1f ip \x1f mac \x1f iface \x1f gast
read -r -d '' PY_DEVICES <<'PY'
import sys, os, urllib.request
import xml.etree.ElementTree as ET
ip, user = sys.argv[1:3]
pw = os.environ.get("LB_PASS", "")
base = f"http://{ip}:49000"
URN = "urn:dslforum-org:service:Hosts:1"
mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
mgr.add_password(None, base + "/", user, pw)
op = urllib.request.build_opener(urllib.request.HTTPDigestAuthHandler(mgr))

def soap(action, inner=""):
    body = ('<?xml version="1.0" encoding="utf-8"?>'
            '<s:Envelope s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"'
            ' xmlns:s="http://schemas.xmlsoap.org/soap/envelope/">'
            f'<s:Body><u:{action} xmlns:u="{URN}">{inner}</u:{action}></s:Body></s:Envelope>').encode()
    req = urllib.request.Request(base + "/upnp/control/hosts", data=body, headers={
        "Content-Type": 'text/xml; charset="utf-8"', "SoapAction": f"{URN}#{action}"})
    root = ET.fromstring(op.open(req, timeout=10).read())
    return {el.tag.split("}")[-1]: (el.text or "") for el in root.iter()
            if el.tag.split("}")[-1].startswith("New")}

rows = {}
def add(name, ipa, mac, act, ifc, guest):
    mac = mac.strip().lower()
    if mac:
        rows[mac] = (act == "1", name.replace("\x1f", " ").strip(), ipa.strip(), mac, ifc.strip(), guest == "1")

try:
    path = soap("X_AVM-DE_GetHostListPath")["NewX_AVM-DE_HostListPath"]
    root = ET.fromstring(op.open(base + path, timeout=20).read())
    for it in root.iter("Item"):
        g = lambda t: (it.findtext(t) or "").strip()
        add(g("HostName"), g("IPAddress"), g("MACAddress"), g("Active"),
            g("InterfaceType"), g("X_AVM-DE_Guest"))
except Exception as e1:
    try:
        n = int(soap("GetHostNumberOfEntries")["NewHostNumberOfEntries"])
        for i in range(n):
            try:
                e = soap("GetGenericHostEntry", f"<NewIndex>{i}</NewIndex>")
            except Exception:
                continue
            add(e.get("NewHostName", ""), e.get("NewIPAddress", ""), e.get("NewMACAddress", ""),
                e.get("NewActive", ""), e.get("NewInterfaceType", ""), "0")
    except Exception as e2:
        print(f"Fehler: {e2}", file=sys.stderr); sys.exit(1)

for act, name, ipa, mac, ifc, guest in sorted(rows.values(), key=lambda r: (not r[0], r[1].lower(), r[3])):
    print("\x1f".join(["1" if act else "0", name, ipa, mac, ifc, "1" if guest else "0"]))
PY

fetch_devices() {  # fetch_devices ZIELDATEI
  LB_PASS="$FB_PASS" python3 -c "$PY_DEVICES" "$FB_IP" "$FB_USER" > "$1" 2>/dev/null
}

load_devices() {  # load_devices DATEI → DEV_* + DEV_MAP (Namensauflösung ohne Forks)
  local act n ip mac ifc gst
  DEV_NAME=(); DEV_IP=(); DEV_MAC=(); DEV_IF=(); DEV_ACT=(); DEV_GUEST=(); DEV_COUNT=0
  DEV_MAP="$NL"
  while IFS="$US" read -r act n ip mac ifc gst; do
    [[ -n $mac ]] || continue
    DEV_ACT+=("$act"); DEV_NAME+=("$n"); DEV_IP+=("$ip"); DEV_MAC+=("$mac")
    DEV_IF+=("$ifc"); DEV_GUEST+=("$gst")
    DEV_COUNT=$((DEV_COUNT + 1))
    [[ -n $n ]] && DEV_MAP+="$mac=$n$NL"
  done < "$1"
  DEV_AT=$SECONDS
}

resolve_name() {  # MAC → R_NAME (Fallback: ?xx:xx)
  R_NAME=""
  if [[ $DEV_MAP == *"$NL$1="* ]]; then
    local rest=${DEV_MAP#*"$NL$1="}
    R_NAME=${rest%%"$NL"*}
  fi
  [[ -n $R_NAME ]] || R_NAME="?${1: -5}"
}

# ---------- Fritzbox: Paketaufzeichnung ----------
capture_stopall() {
  [[ -n $SID ]] || return 0
  curl -s --max-time 8 \
    "http://${FB_IP}/cgi-bin/capture_notimeout?iface=stopall&capture=Stop&sid=${SID}" \
    -o /dev/null 2>/dev/null
  CAPTURE_ON=0
  return 0
}

key_writer() {
  while read_key; do
    [[ -n $R_KEY && $R_KEY != NONE ]] && printf 'K;%s\n' "$R_KEY"
  done
}

ticker() { while sleep 1; do printf 'T\n'; done; }

pipeline_start() {  # curl (pcap-Stream) → tshark → FIFO_OUT
  FIFO_PCAP="$TMPD/pcap"
  rm -f "$FIFO_PCAP"; mkfifo "$FIFO_PCAP"
  tshark -n -l -i - -Y 'dns.flags.response == 0' -T fields -E separator=';' \
    -e frame.time -e eth.src -e ip.src -e ipv6.src -e dns.qry.name \
    < "$FIFO_PCAP" > "$FIFO_OUT" 2>/dev/null &
  TSHARK_PID=$!
  curl -s -N --connect-timeout 5 \
    "http://${FB_IP}/cgi-bin/capture_notimeout?sid=${SID}&capture=Start&snaplen=&filter=&ifaceorminor=${CAPTURE_IFACE}" \
    > "$FIFO_PCAP" 2>/dev/null &
  CURL_PID=$!
  CAPTURE_ON=1
}

pipeline_stop() {
  kill_wait "$CURL_PID"; kill_wait "$TSHARK_PID"
  CURL_PID=""; TSHARK_PID=""
  [[ -n $FIFO_PCAP ]] && rm -f "$FIFO_PCAP"
  FIFO_PCAP=""
}

pipeline_alive() {
  [[ -n $CURL_PID && -n $TSHARK_PID ]] || return 1
  kill -0 "$CURL_PID" 2>/dev/null && kill -0 "$TSHARK_PID" 2>/dev/null
}

session_start() {
  FIFO_OUT="$TMPD/out"
  rm -f "$FIFO_OUT"; mkfifo "$FIFO_OUT"
  exec 3<> "$FIFO_OUT"
  key_writer < /dev/tty > "$FIFO_OUT" &
  KEY_PID=$!
  ticker > "$FIFO_OUT" &
  TICK_PID=$!
  pipeline_start
}

session_stop() {
  kill_wait "$KEY_PID"; kill_wait "$TICK_PID"
  KEY_PID=""; TICK_PID=""
  restore_tty
  pipeline_stop
  exec 3>&- 3<&-
  [[ -n $FIFO_OUT ]] && rm -f "$FIFO_OUT"
  FIFO_OUT=""
}

# ---------- Sperrliste ----------
# Normalisiert per awk: Kommentare, hosts-Format ("0.0.0.0 domain"), "*."-Präfix,
# Punkte, Kleinschreibung. Ergebnis als Newline-Set → Lookup ohne Forks.
load_blocklist() {
  BL_SET="$NL"; BL_COUNT=0
  [[ -f $BLOCKLIST_FILE ]] || return 1
  awk '{
    sub(/#.*/, ""); gsub(/\r/, "")
    n = split($0, f, /[ \t]+/); d = ""
    for (i = 1; i <= n; i++) if (f[i] != "") { first = (d == ""); if (first) d = f[i]; else { d = f[i]; break } }
    d = tolower(d); sub(/^\*\./, "", d); sub(/^\./, "", d); sub(/\.$/, "", d)
    if (d != "" && d !~ /^[0-9.:]+$/ ) print d
  }' "$BLOCKLIST_FILE" | sort -u > "$TMPD/bl.txt"
  BL_COUNT=$(wc -l < "$TMPD/bl.txt" | tr -d ' ')
  ((BL_COUNT > 0)) || return 1
  BL_SET="$NL$(<"$TMPD/bl.txt")$NL"
}

domain_hit() {  # Suffix-Match: d, dann jeweils ohne linkes Label
  local c=${1%.}
  while :; do
    [[ $BL_SET == *"$NL$c$NL"* ]] && return 0
    [[ $c == *.* ]] || return 1
    c=${c#*.}
  done
}

blocklist_help() {
  warn "⚠️  Keine (nutzbare) blocklist.txt gefunden."
  echo
  printf '  Lege die Datei %s%s%s an. Eine Domain pro Zeile, z.B.:\n\n' "$C_TEAL" "$BLOCKLIST_FILE" "$C_RESET"
  printf '    %sexample.com%s\n    %stracking.example.org%s\n\n' "$C_TEXT" "$C_RESET" "$C_TEXT" "$C_RESET"
  printf '  Ein Eintrag matcht auch alle Subdomains. %s#%s = Kommentar,\n' "$C_PEACH" "$C_RESET"
  printf '  hosts-Format (%s0.0.0.0 domain%s) wird ebenfalls verstanden.\n' "$C_PEACH" "$C_RESET"
}

# ---------- Telegram ----------
cfg_esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; printf '%s' "$s"; }

tg_api() {  # tg_api TEXT → JSON-Antwort. Token via curl-Config auf stdin (nicht in ps).
  printf 'url = "https://api.telegram.org/bot%s/sendMessage"\ndata-urlencode = "chat_id=%s"\ndata-urlencode = "text=%s"\n' \
    "$(cfg_esc "$TG_TOKEN")" "$(cfg_esc "$TG_CHAT_ID")" "$(cfg_esc "$1")" \
    | curl -s --max-time 10 -K -
}

tg_send() { [[ -n $TG_TOKEN && -n $TG_CHAT_ID ]] && { tg_api "$1" >/dev/null 2>&1 & } ; return 0; }

tg_test() {  # synchron; Erfolg/Fehlertext
  local resp
  resp=$(tg_api "✅ lauschbox verbunden ($(hostname -s))") || { R_NAME="keine Verbindung zu api.telegram.org"; return 1; }
  [[ $resp == *'"ok":true'* ]] && return 0
  R_NAME=${resp#*\"description\":\"}; R_NAME=${R_NAME%%\"*}
  [[ -n $R_NAME ]] || R_NAME="unbekannte Antwort"
  return 1
}

seen_within() {  # seen_within PRÄFIX KEY SEKUNDEN → 0 wenn zuletzt < n s gesehen, sonst merken
  local v="$1${2//[^A-Za-z0-9]/_}" last
  last=${!v:-}
  if [[ -n $last ]] && (( SECONDS - last < $3 )); then return 0; fi
  printf -v "$v" '%s' "$SECONDS"
  return 1
}

prune_seen() {  # Dedupe-/Cooldown-Variablen begrenzen
  local -a vs
  vs=($(compgen -v | grep -E '^(DD|NC)_' )) 2>/dev/null
  if ((${#vs[@]} > 5000)); then unset "${vs[@]}"; fi
}

# ---------- DNS-Logging-Ansicht ----------
SPARK=("▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")

toggle_dot() { if [[ $1 == 1 ]]; then printf '%s●' "$C_GREEN"; else printf '%s○' "$C_RED"; fi; }

draw_bar() {  # Pill-Tastenleiste in der letzten Zeile
  local long=0 s
  ((COLS >= 104)) && long=1
  local L_g="Gerätefilter" L_e="ändern" L_s="Sperrliste" L_t="Telegram" L_p="Pause" L_l="Datei" L_c="leeren" L_x="Menü"
  ((long)) || { L_g="Filter"; L_e="ändern"; L_s="Sperre"; L_t="TG"; L_l="Log"; L_c="clr"; }
  s="${C_BG}"
  s+=" ${C_MAUVE}${C_BOLD}g${C_NOBOLD}${C_TEXT} $L_g $(toggle_dot "$FILTER_ON")"
  s+="  ${C_MAUVE}${C_BOLD}e${C_NOBOLD}${C_TEXT} $L_e"
  s+="  ${C_MAUVE}${C_BOLD}s${C_NOBOLD}${C_TEXT} $L_s $(toggle_dot "$BLOCK_ON")"
  if [[ $BLOCK_ON == 1 ]]; then
    s+="  ${C_MAUVE}${C_BOLD}t${C_NOBOLD}${C_TEXT} $L_t $(toggle_dot "$TG_ON")"
  else
    s+="  ${C_OVERLAY}t $L_t ○"
  fi
  s+="  ${C_MAUVE}${C_BOLD}p${C_NOBOLD}${C_TEXT} $L_p $(toggle_dot "$PAUSED")"
  s+="  ${C_MAUVE}${C_BOLD}l${C_NOBOLD}${C_TEXT} $L_l $(toggle_dot "$FILE_ON")"
  s+="  ${C_MAUVE}${C_BOLD}c${C_NOBOLD}${C_TEXT} $L_c"
  s+="  ${C_MAUVE}${C_BOLD}x${C_NOBOLD}${C_TEXT} $L_x"
  printf '\033[%d;1H%s\033[K%s' "$ROWS" "$s" "$C_RESET"
}

draw_rule() {  # Trennlinie mit Filter-/Sperrlisten-Chip
  local chip
  if [[ $FILTER_ON == 1 ]]; then chip="📱 ${DEVICE_FILTER_NAMES:-Alle Netzwerkgeräte}"
  else chip="📱 alle Geräte (Filter aus)"; fi
  [[ $BLOCK_ON == 1 ]] && chip+="  ·  🚫 nur Sperrliste ($BL_COUNT)"
  chip+="  ·  $CAPTURE_IFACE"
  local max=$((COLS - 8))
  ((${#chip} > max)) && chip="${chip:0:$((max - 1))}…"
  printf '\033[%d;1H\033[2K %s── %s%s%s ' "$((ROWS - 2))" "$C_OVERLAY" "$C_SKY" "$chip" "$C_OVERLAY"
  rep "─" $((COLS - ${#chip} - 5))
  printf '%s' "$C_RESET"
}

draw_status() {  # Live-/Pin-Status, Sparkline, Zähler, Meldung
  local st sp="" v max=1 idx sum=0 n=${#BUCKETS[@]} rate i from line
  if ((RECONNECT)); then st="${C_PEACH}↻ RECONNECT"
  elif ((LOG_OFF > 0 || PAUSED)); then
    st="${C_YELLOW}⏸ PAUSE"
    ((LOG_NEW > 0)) && st+=" ${C_OVERLAY}(+$LOG_NEW neu)"
    ((LOG_OFF > 0)) && st+=" ${C_OVERLAY}↑$LOG_OFF"
  else st="${C_GREEN}● LIVE"; fi
  for v in ${BUCKETS[@]+"${BUCKETS[@]}"}; do ((v > max)) && max=$v; done
  local sw=24; ((COLS < 100)) && sw=12
  from=$((n > sw ? n - sw : 0))
  for ((i = from; i < n; i++)); do
    v=${BUCKETS[i]}
    if ((v == 0)); then sp+="${C_OVERLAY}▁"
    else idx=$((v * 7 / max)); sp+="${C_TEAL}${SPARK[idx]}"; fi
  done
  from=$((n > 10 ? n - 10 : 0))
  for ((i = from; i < n; i++)); do sum=$((sum + BUCKETS[i])); done
  rate=0; ((n > from)) && rate=$((sum * 10 / (n - from)))
  line=" $st  $sp  ${C_TEXT}Σ $CNT_TOTAL${C_OVERLAY} · ${C_RED}🚫 $CNT_HIT${C_OVERLAY} · ${C_TEXT}$((rate / 10)).$((rate % 10))/s"
  local room=$((COLS - sw - 44)) m=$MSG_TEXT
  if [[ -n $m ]] && ((room > 12)); then
    ((${#m} > room)) && m="${m:0:$((room - 1))}…"
    line+="  ${C_PEACH}${m}"
  fi
  printf '\033[%d;1H\033[2K%s%s' "$((ROWS - 1))" "$line" "$C_RESET"
}

msg() { MSG_TEXT=$1; MSG_UNTIL=$((SECONDS + 6)); draw_status; }

fmt_rec() {  # Record (US-getrennt) → R_LINE, passend zur aktuellen Breite
  local rec=$1 ts name ip d hit rest dc gut dw
  ts=${rec%%"$US"*}; rest=${rec#*"$US"}
  name=${rest%%"$US"*}; rest=${rest#*"$US"}
  ip=${rest%%"$US"*}; rest=${rest#*"$US"}
  d=${rest%%"$US"*}; hit=${rest#*"$US"}
  ((${#name} > NAME_W)) && name="${name:0:$((NAME_W - 1))}…"
  ((${#ip} > IP_W)) && ip="${ip:0:$((IP_W - 1))}…"
  dw=$((COLS - 13 - NAME_W - IP_W))
  ((dw < 8)) && dw=8
  ((${#d} > dw)) && d="${d:0:$((dw - 1))}…"
  if [[ $hit == 1 ]]; then dc="${C_RED}${C_BOLD}"; gut="${C_RED}▌"; else dc=$C_TEXT; gut=" "; fi
  R_LINE=" ${gut} ${C_OVERLAY}${ts} ${C_SKY}${name}${SPACES:0:$((NAME_W - ${#name}))} ${C_BLUE}${ip}${SPACES:0:$((IP_W - ${#ip}))} ${dc}${d}${C_RESET}"
}

log_push() {
  LOG_BUF+=("$1")
  local n=${#LOG_BUF[@]} slack=$((LOG_MAX_LINES / 4 + 16))
  # in Blöcken kappen statt bei jeder Zeile umzukopieren
  if ((n > LOG_MAX_LINES + slack)); then
    LOG_BUF=("${LOG_BUF[@]:$((n - LOG_MAX_LINES))}")
  fi
}

log_render() {  # Fenster absolut zeichnen; SHOWN = belegte Zeilen
  local n=${#LOG_BUF[@]} start i cnt
  start=$((n - LOG_OFF - LOG_VIEW_H)); ((start < 0)) && start=0
  cnt=$((n - LOG_OFF - start)); ((cnt > LOG_VIEW_H)) && cnt=$LOG_VIEW_H
  ((cnt < 0)) && cnt=0
  for ((i = 0; i < LOG_VIEW_H; i++)); do
    printf '\033[%d;1H\033[2K' $((VIEW_TOP + i))
    if ((i < cnt)); then fmt_rec "${LOG_BUF[start + i]}"; printf '%s' "$R_LINE"; fi
  done
  SHOWN=$cnt
}

log_emit() {  # eine neue Zeile im Follow-Modus (absolut positioniert, scrollt am unteren Rand)
  if ((SHOWN < LOG_VIEW_H)); then
    printf '\033[%d;1H\033[2K%s' $((VIEW_TOP + SHOWN)) "$R_LINE"
    SHOWN=$((SHOWN + 1))
  else
    printf '\033[%d;1H\n%s' "$VIEW_BOT" "$R_LINE"
  fi
}

log_scroll() {  # delta > 0 = ältere Einträge
  local n=${#LOG_BUF[@]} max_off
  max_off=$((n - LOG_VIEW_H)); ((max_off < 0)) && max_off=0
  LOG_OFF=$((LOG_OFF + $1))
  ((LOG_OFF > max_off)) && LOG_OFF=$max_off
  ((LOG_OFF < 0)) && LOG_OFF=0
  if ((LOG_OFF == 0 && $1 < 0)); then LOG_NEW=0; PAUSED=0; fi
  log_render; draw_status; draw_bar
}

handle_query() {  # ftime fmac ip4 ip6 names
  local ftime=$1 fmac=$2 ip=${3:-${4:-}} names=$5 ts name d hit rec
  [[ -n $names ]] || return 0
  if [[ $FILTER_ON == 1 && $DEVICE_FILTER != ALL ]]; then
    [[ ,$DEVICE_FILTER, == *",$fmac,"* ]] || return 0
  fi
  ts=$ftime
  [[ $ftime =~ [0-9]{2}:[0-9]{2}:[0-9]{2} ]] && ts=${BASH_REMATCH[0]}
  resolve_name "$fmac"; name=$R_NAME
  [[ -n $ip ]] || ip="-"
  local IFS=,
  for d in $names; do
    [[ -z $d ]] && continue
    d=${d%.}
    # A/AAAA/HTTPS-Bursts derselben Anfrage nur einmal zeigen
    if ((DEDUPE_SECS > 0)) && seen_within DD_ "${fmac}_$d" "$DEDUPE_SECS"; then continue; fi
    hit=0
    domain_hit "$d" && hit=1
    if [[ $BLOCK_ON == 1 && $hit == 0 ]]; then continue; fi
    CNT_TOTAL=$((CNT_TOTAL + 1)); CUR_BUCKET=$((CUR_BUCKET + 1))
    if ((hit)); then
      CNT_HIT=$((CNT_HIT + 1))
      if [[ $TG_ON == 1 ]]; then
        if ((NOTIFY_COOLDOWN == 0)) || ! seen_within NC_ "${fmac}_$d" "$NOTIFY_COOLDOWN"; then
          tg_send "🚨 lauschbox: Sperrlisten-Treffer
Gerät: $name ($ip)
Domain: $d
Zeit: $ts"
        fi
      fi
    fi
    printf '%s\t%s\t%s\n' "$name" "$d" "$hit" >> "$STATS"
    ((FILE_ON)) && printf '%s %s %s %s %s%s\n' "$TODAY" "$ts" "$name" "$ip" "$d" "$([[ $hit == 1 ]] && echo ' [TREFFER]')" >> "$LOG_FILE"
    rec="$ts$US$name$US$ip$US$d$US$hit"
    log_push "$rec"
    if ((LOG_OFF > 0 || PAUSED)); then
      LOG_OFF=$((LOG_OFF + 1)); LOG_NEW=$((LOG_NEW + 1))   # Fenster bleibt stehen
    else
      fmt_rec "$rec"; log_emit
    fi
  done
}

view_draw() {  # kompletter Neuaufbau (Start + Resize)
  layout
  VIEW_TOP=$((HDR_ROWS + 1)); VIEW_BOT=$((ROWS - 3))
  LOG_VIEW_H=$((VIEW_BOT - VIEW_TOP + 1)); ((LOG_VIEW_H < 1)) && LOG_VIEW_H=1
  printf '\033[r\033[H\033[2J'
  header
  printf '\033[%d;%dr' "$VIEW_TOP" "$VIEW_BOT"
  log_render; draw_rule; draw_status; draw_bar
}

view_setup() {
  printf '\033[?25l\033[?1000h\033[?1006h'
  view_draw
}
view_teardown() { printf '\033[r\033[?1000l\033[?1006l\033[?25h'; }

reconnect_step() {  # wird pro Tick aufgerufen, solange RECONNECT=1
  RETRY_IN=$((RETRY_IN - 1))
  if ((RETRY_IN > 0)); then msg "Verbindung verloren — neuer Versuch in ${RETRY_IN}s"; return; fi
  msg "Verbindung verloren — melde neu an …"
  pipeline_stop
  if fb_login; then
    capture_stopall
    pipeline_start
    RECONNECT=0; ALIVE_TICKS=0
    msg "✔ Verbindung wiederhergestellt"
  else
    BACKOFF=$((BACKOFF * 2)); ((BACKOFF > 60)) && BACKOFF=60
    RETRY_IN=$BACKOFF
    msg "Login fehlgeschlagen — nächster Versuch in ${RETRY_IN}s"
  fi
}

on_tick() {
  local sz
  TICKS=$((TICKS + 1))
  BUCKETS+=("$CUR_BUCKET"); CUR_BUCKET=0
  ((${#BUCKETS[@]} > 60)) && BUCKETS=("${BUCKETS[@]:30}")
  # Resize
  sz=$(stty size 2>/dev/null </dev/tty) || sz=""
  if [[ -n $sz && $sz != "$ROWS $COLS" ]]; then view_draw; fi
  # Capture-Überwachung
  if ((RECONNECT)); then
    reconnect_step
  elif ! pipeline_alive; then
    RECONNECT=1; RETRY_IN=$BACKOFF
    msg "Aufzeichnung beendet — Reconnect …"
  else
    ALIVE_TICKS=$((ALIVE_TICKS + 1))
    ((ALIVE_TICKS >= 10)) && BACKOFF=2
  fi
  # Geräteliste im Hintergrund auffrischen
  if [[ -n $DEVREF_PID ]] && ! kill -0 "$DEVREF_PID" 2>/dev/null; then
    if wait "$DEVREF_PID" 2>/dev/null && [[ -s $TMPD/dev.new ]]; then load_devices "$TMPD/dev.new"; fi
    DEVREF_PID=""
  elif [[ -z $DEVREF_PID ]] && ((DEVICE_REFRESH_SECS > 0 && SECONDS - DEV_AT >= DEVICE_REFRESH_SECS)); then
    DEV_AT=$SECONDS
    fetch_devices "$TMPD/dev.new" &
    DEVREF_PID=$!
  fi
  ((TICKS % 60 == 0)) && { TODAY=$(date +%F); prune_seen; }
  if [[ -n $MSG_TEXT ]] && ((SECONDS >= MSG_UNTIL)); then MSG_TEXT=""; fi
  draw_status
}

toggle_filter() {
  if [[ $FILTER_ON == 1 ]]; then FILTER_ON=0; msg "Gerätefilter aus — alle Geräte werden geloggt"
  else FILTER_ON=1; msg "Gerätefilter an: ${DEVICE_FILTER_NAMES:-Alle Netzwerkgeräte}"; fi
  draw_rule; draw_bar
}

toggle_block() {
  if [[ $BLOCK_ON == 1 ]]; then
    BLOCK_ON=0; TG_ON=0
    msg "Sperrliste aus — alle Anfragen werden angezeigt"
  elif load_blocklist; then
    BLOCK_ON=1; msg "Sperrliste an ($BL_COUNT Einträge) — nur Treffer werden angezeigt"
  else
    msg "⚠ blocklist.txt fehlt oder leer (Hauptmenü → Sperrliste)"
  fi
  draw_rule; draw_bar
}

toggle_pause() {
  if ((PAUSED || LOG_OFF > 0)); then
    PAUSED=0; LOG_OFF=0; LOG_NEW=0; log_render; msg "Live-Ansicht"
  else
    PAUSED=1; msg "Angehalten — Log läuft im Hintergrund weiter"
  fi
  draw_status; draw_bar
}

toggle_file() {
  if ((FILE_ON)); then FILE_ON=0; msg "Datei-Log aus"
  else
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null
    if : >> "$LOG_FILE" 2>/dev/null; then FILE_ON=1; TODAY=$(date +%F); msg "Datei-Log an → $LOG_FILE"
    else msg "⚠ $LOG_FILE nicht beschreibbar"; fi
  fi
  draw_bar
}

ui_loop() {
  EVENT=""
  local f1 f2 f3 f4 f5 h
  while IFS=';' read -r f1 f2 f3 f4 f5 <&3; do
    case $f1 in
      T) on_tick ;;
      K)
        case $f2 in
          UP)   log_scroll 1 ;;
          DOWN) log_scroll -1 ;;
          PGUP) log_scroll "$LOG_VIEW_H" ;;
          PGDN) log_scroll "-$LOG_VIEW_H" ;;
          HOME) log_scroll "${#LOG_BUF[@]}" ;;
          END)  PAUSED=0; log_scroll "-${#LOG_BUF[@]}" ;;
          WUP)  log_scroll 3 ;;
          WDN)  log_scroll -3 ;;
          g) toggle_filter ;;
          s) toggle_block ;;
          p) toggle_pause ;;
          l) toggle_file ;;
          c)
            LOG_BUF=(); LOG_OFF=0; LOG_NEW=0; PAUSED=0; : > "$STATS"
            CNT_TOTAL=0; CNT_HIT=0
            log_render; draw_status; msg "Puffer und Zähler geleert" ;;
          e) EVENT=e; return ;;
          t)
            if [[ $BLOCK_ON != 1 ]]; then
              msg "⚠ Telegram nur bei aktiver Sperrliste (Taste s)"
            elif [[ $TG_ON == 1 ]]; then
              TG_ON=0; draw_bar; msg "Telegram-Benachrichtigung aus"
            elif load_tg; then
              TG_ON=1; draw_bar; msg "Telegram-Benachrichtigung an"
            else
              EVENT=t; return
            fi ;;
          x|q) EVENT=x; return ;;
        esac ;;
      "") : ;;
      *) handle_query "$f1" "$f2" "$f3" "$f4" "$f5" ;;
    esac
  done
}

