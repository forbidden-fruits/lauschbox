fetch_devices() {  # fetch_devices ZIELDATEI
  LB_PASS="$FB_PASS" python3 -c "$PY_DEVICES" "$FB_IP" "$FB_USER" > "$1" 2>/dev/null
}

load_devices() {  # load_devices DATEI → DEV_* + DEV_MAP (Namensauflösung ohne Forks)
  local act n ip mac ifc gst
  DEV_NAME=(); DEV_IP=(); DEV_MAC=(); DEV_IF=(); DEV_ACT=(); DEV_GUEST=(); DEV_COUNT=0
  DEV_MAP="$NL"
  while IFS="$US" read -r act n ip mac ifc gst; do
    [[ -n $mac ]] || continue
    DEV_ACT+=("$act"); DEV_NAME+=("$n"); DEV_IP+=("$ip"); DEV_MAC+=("$mac")
    DEV_IF+=("$ifc"); DEV_GUEST+=("$gst")
    DEV_COUNT=$((DEV_COUNT + 1))
    [[ -n $n ]] && DEV_MAP+="$mac=$n$NL"
  done < "$1"
  DEV_AT=$SECONDS
}

resolve_name() {  # MAC → R_NAME (Fallback: ?xx:xx)
  R_NAME=""
  if [[ $DEV_MAP == *"$NL$1="* ]]; then
    local rest=${DEV_MAP#*"$NL$1="}
    R_NAME=${rest%%"$NL"*}
  fi
  [[ -n $R_NAME ]] || R_NAME="?${1: -5}"
}

# ---------- Fritzbox: Paketaufzeichnung ----------
capture_stopall() {
  [[ -n $SID ]] || return 0
  curl -s --max-time 8 \
    "http://${FB_IP}/cgi-bin/capture_notimeout?iface=stopall&capture=Stop&sid=${SID}" \
    -o /dev/null 2>/dev/null
  CAPTURE_ON=0
  return 0
}

key_writer() {
  while read_key; do
    [[ -n $R_KEY && $R_KEY != NONE ]] && printf 'K;%s\n' "$R_KEY"
  done
}

ticker() { while sleep 1; do printf 'T\n'; done; }

pipeline_start() {  # curl (pcap-Stream) → tshark → FIFO_OUT
  FIFO_PCAP="$TMPD/pcap"
  rm -f "$FIFO_PCAP"; mkfifo "$FIFO_PCAP"
  tshark -n -l -i - -Y 'dns.flags.response == 0' -T fields -E separator=';' \
    -e frame.time -e eth.src -e ip.src -e ipv6.src -e dns.qry.name \
    < "$FIFO_PCAP" > "$FIFO_OUT" 2>/dev/null &
  TSHARK_PID=$!
  curl -s -N --connect-timeout 5 \
    "http://${FB_IP}/cgi-bin/capture_notimeout?sid=${SID}&capture=Start&snaplen=&filter=&ifaceorminor=${CAPTURE_IFACE}" \
    > "$FIFO_PCAP" 2>/dev/null &
  CURL_PID=$!
  CAPTURE_ON=1
}

pipeline_stop() {
  kill_wait "$CURL_PID"; kill_wait "$TSHARK_PID"
  CURL_PID=""; TSHARK_PID=""
  [[ -n $FIFO_PCAP ]] && rm -f "$FIFO_PCAP"
  FIFO_PCAP=""
}

pipeline_alive() {
  [[ -n $CURL_PID && -n $TSHARK_PID ]] || return 1
  kill -0 "$CURL_PID" 2>/dev/null && kill -0 "$TSHARK_PID" 2>/dev/null
}

session_start() {
  FIFO_OUT="$TMPD/out"
  rm -f "$FIFO_OUT"; mkfifo "$FIFO_OUT"
  exec 3<> "$FIFO_OUT"
  key_writer < /dev/tty > "$FIFO_OUT" &
  KEY_PID=$!
  ticker > "$FIFO_OUT" &
  TICK_PID=$!
  pipeline_start
  ((WEB_ON)) && web_start
}

session_stop() {
  kill_wait "$KEY_PID"; kill_wait "$TICK_PID"
  KEY_PID=""; TICK_PID=""
  restore_tty
  web_stop
  pipeline_stop
  exec 3>&- 3<&-
  [[ -n $FIFO_OUT ]] && rm -f "$FIFO_OUT"
  FIFO_OUT=""
}

# ---------- Sperrliste ----------
# Normalisiert per awk: Kommentare, hosts-Format ("0.0.0.0 domain"), "*."-Präfix,
# Punkte, Kleinschreibung. Ergebnis als Newline-Set → Lookup ohne Forks.
load_blocklist() {
  BL_SET="$NL"; BL_COUNT=0
  [[ -f $BLOCKLIST_FILE ]] || return 1
  awk '{
    sub(/#.*/, ""); gsub(/\r/, "")
    n = split($0, f, /[ \t]+/); d = ""
    for (i = 1; i <= n; i++) if (f[i] != "") { first = (d == ""); if (first) d = f[i]; else { d = f[i]; break } }
    d = tolower(d); sub(/^\*\./, "", d); sub(/^\./, "", d); sub(/\.$/, "", d)
    if (d != "" && d !~ /^[0-9.:]+$/ ) print d
  }' "$BLOCKLIST_FILE" | sort -u > "$TMPD/bl.txt"
  BL_COUNT=$(wc -l < "$TMPD/bl.txt" | tr -d ' ')
  ((BL_COUNT > 0)) || return 1
  BL_SET="$NL$(<"$TMPD/bl.txt")$NL"
}

domain_hit() {  # Suffix-Match: d, dann jeweils ohne linkes Label
  local c=${1%.}
  while :; do
    [[ $BL_SET == *"$NL$c$NL"* ]] && return 0
    [[ $c == *.* ]] || return 1
    c=${c#*.}
  done
}

blocklist_help() {
  warn "⚠  Keine (nutzbare) blocklist.txt gefunden."
  echo
  printf '  Lege die Datei %s%s%s an. Eine Domain pro Zeile, z.B.:\n\n' "$C_TEAL" "$BLOCKLIST_FILE" "$C_RESET"
  printf '    %sexample.com%s\n    %stracking.example.org%s\n\n' "$C_TEXT" "$C_RESET" "$C_TEXT" "$C_RESET"
  printf '  Ein Eintrag matcht auch alle Subdomains. %s#%s = Kommentar,\n' "$C_PEACH" "$C_RESET"
  printf '  hosts-Format (%s0.0.0.0 domain%s) wird ebenfalls verstanden.\n' "$C_PEACH" "$C_RESET"
}

