seen_within() {  # seen_within PRÄFIX KEY SEKUNDEN → 0 wenn zuletzt < n s gesehen, sonst merken
  local v="$1${2//[^A-Za-z0-9]/_}" last
  last=${!v:-}
  if [[ -n $last ]] && (( SECONDS - last < $3 )); then return 0; fi
  printf -v "$v" '%s' "$SECONDS"
  return 1
}

prune_seen() {  # Dedupe-/Cooldown-Variablen begrenzen
  local -a vs
  vs=($(compgen -v | grep -E '^(DD|NC)_' )) 2>/dev/null
  if ((${#vs[@]} > 5000)); then unset "${vs[@]}"; fi
}

