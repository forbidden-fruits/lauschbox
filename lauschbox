menu_dashboard() {  # Statuszeilen
  local fbs tgs fs bls lfs
  if load_fb; then fbs="${C_GREEN}● ${C_TEXT}$FB_IP ${C_OVERLAY}($FB_USER)"; else fbs="${C_RED}○ ${C_OVERLAY}nicht konfiguriert"; fi
  if load_tg; then tgs="${C_GREEN}● ${C_TEXT}konfiguriert"; else tgs="${C_RED}○ ${C_OVERLAY}nicht konfiguriert"; fi
  if load_filter; then fs="${C_SKY}${DEVICE_FILTER_NAMES}"; else fs="${C_OVERLAY}noch nicht gewählt"; fi
  if load_blocklist; then bls="${C_GREEN}● ${C_TEXT}${BL_COUNT} Domains"; else bls="${C_RED}○ ${C_OVERLAY}keine blocklist.txt"; fi
  if [[ $LOG_FILE == "$LOG_FILE_DEFAULT" ]]; then lfs="${C_TEXT}${LOG_FILE/#$HOME/~} ${C_OVERLAY}(Standard)"; else lfs="${C_TEXT}${LOG_FILE/#$HOME/~}"; fi
  DASH_1="  ${C_OVERLAY}Fritzbox    $fbs"
  DASH_2="  ${C_OVERLAY}Telegram    $tgs"
  DASH_3="  ${C_OVERLAY}Filter      $fs"
  DASH_4="  ${C_OVERLAY}Sperrliste  $bls"
  DASH_5="  ${C_OVERLAY}Logdatei    $lfs"
}

menu_draw() {  # menu_draw AUSWAHL
  local i n=${#MENU_LABELS[@]} row=$((HDR_ROWS + 1))
  printf '\033[%d;1H' "$row"
  printf '%s\033[K%s\n%s\033[K%s\n%s\033[K%s\n%s\033[K%s\n%s\033[K%s\n\033[K\n' \
    "$DASH_1" "$C_RESET" "$DASH_2" "$C_RESET" "$DASH_3" "$C_RESET" "$DASH_4" "$C_RESET" "$DASH_5" "$C_RESET"
  for ((i = 0; i < n; i++)); do
    if ((i == $1)); then
      printf '  %s%s ▸ %s%d%s  %s%s%s\033[K%s\n' "$C_SEL" "$C_MAUVE" "$C_BOLD" "$((i + 1))" "$C_NOBOLD" "$C_TEXT" "${MENU_LABELS[i]}" "" "$C_RESET"
    else
      printf '  %s   %d%s  %s%s\033[K\n' "$C_OVERLAY" "$((i + 1))" "$C_RESET" "$C_TEXT" "${MENU_LABELS[i]}"
    fi
  done
  printf '%s\033[K\n  %s↑/↓ wählen · Enter öffnen · 1-%d direkt · q Ende%s\033[K' "$C_RESET" "$C_OVERLAY" "$n" "$C_RESET"
}

menu_run() {
  printf '\033[?1000l\033[?1006l'
  case $1 in
    0) ui_fritzbox ;;
    1) ui_telegram ;;
    2) ui_devices ;;
    3) ui_logging ;;
    4) ui_blocklist ;;
    5) ui_stats ;;
    6) ui_logpath ;;
    7) exit 0 ;;
  esac
  return 0
}

main_menu() {
  local sel=0 n=${#MENU_LABELS[@]} redraw=1
  load_fb && sel=3
  while true; do
    if ((redraw)); then screen; menu_dashboard; redraw=0; fi
    menu_draw "$sel"
    read_key || exit 0
    case $R_KEY in
      UP)   sel=$(((sel + n - 1) % n)) ;;
      DOWN) sel=$(((sel + 1) % n)) ;;
      HOME) sel=0 ;;
      END)  sel=$((n - 1)) ;;
      [1-9]) if ((R_KEY <= n)); then sel=$((R_KEY - 1)); menu_run "$sel"; redraw=1; fi ;;
      "")   menu_run "$sel"; redraw=1 ;;
      q)    exit 0 ;;
    esac
  done
}

