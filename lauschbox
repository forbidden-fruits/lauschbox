reconnect_step() {  # wird pro Tick aufgerufen, solange RECONNECT=1
  RETRY_IN=$((RETRY_IN - 1))
  if ((RETRY_IN > 0)); then msg "Verbindung verloren — neuer Versuch in ${RETRY_IN}s"; return; fi
  msg "Verbindung verloren — melde neu an …"
  pipeline_stop
  if fb_login; then
    capture_stopall
    pipeline_start
    RECONNECT=0; ALIVE_TICKS=0
    msg "✔ Verbindung wiederhergestellt"
  else
    BACKOFF=$((BACKOFF * 2)); ((BACKOFF > 60)) && BACKOFF=60
    RETRY_IN=$BACKOFF
    msg "Login fehlgeschlagen — nächster Versuch in ${RETRY_IN}s"
  fi
}

on_tick() {
  local sz
  TICKS=$((TICKS + 1))
  BUCKETS+=("$CUR_BUCKET"); CUR_BUCKET=0
  ((${#BUCKETS[@]} > 60)) && BUCKETS=("${BUCKETS[@]:30}")
  # Resize
  sz=$(stty size 2>/dev/null </dev/tty) || sz=""
  if [[ -n $sz && $sz != "$ROWS $COLS" ]]; then view_draw; fi
  # Capture-Überwachung
  if ((RECONNECT)); then
    reconnect_step
  elif ! pipeline_alive; then
    RECONNECT=1; RETRY_IN=$BACKOFF
    msg "Aufzeichnung beendet — Reconnect …"
  else
    ALIVE_TICKS=$((ALIVE_TICKS + 1))
    ((ALIVE_TICKS >= 10)) && BACKOFF=2
  fi
  # Geräteliste im Hintergrund auffrischen
  if [[ -n $DEVREF_PID ]] && ! kill -0 "$DEVREF_PID" 2>/dev/null; then
    if wait "$DEVREF_PID" 2>/dev/null && [[ -s $TMPD/dev.new ]]; then
      load_devices "$TMPD/dev.new" && mv -f "$TMPD/dev.new" "$TMPD/dev.tsv"
    fi
    DEVREF_PID=""
  elif [[ -z $DEVREF_PID ]] && ((DEVICE_REFRESH_SECS > 0 && SECONDS - DEV_AT >= DEVICE_REFRESH_SECS)); then
    DEV_AT=$SECONDS
    fetch_devices "$TMPD/dev.new" &
    DEVREF_PID=$!
  fi
  if ((TICKS % 60 == 0)); then
    TODAY=$(date +%F); prune_seen
    if ((WEB_ON)) && [[ -f $WEB_LOG ]] && (( $(wc -l < "$WEB_LOG") > LOG_MAX_LINES )); then
      tail -n "$LOG_MAX_LINES" "$WEB_LOG" > "$WEB_LOG.tmp" && mv -f "$WEB_LOG.tmp" "$WEB_LOG"
    fi
  fi
  if [[ -n $MSG_TEXT ]] && ((SECONDS >= MSG_UNTIL)); then MSG_TEXT=""; fi
  if ((WEB_ON)); then
    if ! kill -0 "$WEB_PID" 2>/dev/null; then
      WEB_ON=0; WEB_PID=""; msg "⚠ Web-UI beendet (Port $WEB_PORT belegt?)"; draw_bar
    else
      web_state_write
    fi
  fi
  draw_status
}

toggle_filter() {
