#!/usr/bin/env bash
#
# lauschbox — TUI zum Loggen der DNS-Aufrufe einer FRITZ!Box
# Umsetzung gemäß PLAN.md / TECH.md
#
set -u
shopt -s nocasematch

# ---------- Pfade ----------
# Konfigdateien & Sperrliste werden zuerst im aktuellen Verzeichnis gesucht,
# danach unter ~/.config/lauschbox (dorthin lädt der Installer die
# blocklist.txt; neu angelegte Konfigdateien landen ebenfalls dort).
CONFIG_DIR="$HOME/.config/lauschbox"
conf_path() {  # conf_path DATEINAME → Pfad im CWD falls vorhanden, sonst in CONFIG_DIR
  if [[ -f $PWD/$1 ]]; then printf '%s/%s' "$PWD" "$1"
  else printf '%s/%s' "$CONFIG_DIR" "$1"; fi
}
ENV_FB="$(conf_path .fritzbox.env)"
ENV_TG="$(conf_path .telegram.env)"
ENV_DEV="$(conf_path .devices.env)"
BLOCKLIST_FILE="$(conf_path blocklist.txt)"

# ---------- lauschbox.env: Puffer-Limits ----------
# Gleiche Suchlogik (CWD zuerst, dann ~/.config/lauschbox); der Installer
# legt sie im Config-Ordner an. Existiert sie dort UND im aktuellen
# Verzeichnis nicht, wird sie mit Defaults im aktuellen Verzeichnis erstellt.
# Ungültige Werte → Default 1000.
ENV_MAIN="$(conf_path lauschbox.env)"
LOG_MAX_LINES=1000
BLOCKLIST_MAX_LINES=1000
if [[ -f $ENV_MAIN ]]; then
  # shellcheck disable=SC1090
  . "$ENV_MAIN"
elif cat > "$PWD/lauschbox.env" 2>/dev/null <<'EOF'
# lauschbox Einstellungen
# Maximale Zeilen im Puffer der DNS-Logging-Ansicht (Ringpuffer)
LOG_MAX_LINES=1000
# Maximale Zeilen aus blocklist.txt in der Sperrlisten-Anzeige
BLOCKLIST_MAX_LINES=1000
EOF
then
  ENV_MAIN="$PWD/lauschbox.env"
fi
[[ $LOG_MAX_LINES =~ ^[0-9]+$ ]] && ((LOG_MAX_LINES > 0)) || LOG_MAX_LINES=1000
[[ $BLOCKLIST_MAX_LINES =~ ^[0-9]+$ ]] && ((BLOCKLIST_MAX_LINES > 0)) || BLOCKLIST_MAX_LINES=1000

# ---------- Farben: Catppuccin Macchiato ----------
_rgb() { printf '\033[38;2;%d;%d;%dm' "$1" "$2" "$3"; }
C_RESET=$'\033[0m'
C_BOLD=$'\033[1m'
C_TEXT="$(_rgb 202 211 245)"      # Text      #cad3f5
C_OVERLAY="$(_rgb 110 115 141)"   # Overlay0  #6e738d (grau)
C_SKY="$(_rgb 145 215 227)"       # Sky       #91d7e3 (hellblau)
C_BLUE="$(_rgb 138 173 244)"      # Blue      #8aadf4 (dunkelblau)
C_RED="$(_rgb 237 135 150)"       # Red       #ed8796
C_GREEN="$(_rgb 166 218 149)"     # Green     #a6da95
C_MAUVE="$(_rgb 198 160 246)"     # Mauve     #c6a0f6
C_PEACH="$(_rgb 245 169 127)"     # Peach     #f5a97f
C_YELLOW="$(_rgb 238 212 159)"    # Yellow    #eed49f
C_TEAL="$(_rgb 139 213 202)"      # Teal      #8bd5ca

# ---------- Globale Zustände ----------
SID=""
FB_IP=""; FB_USER=""; FB_PASS=""
TG_TOKEN=""; TG_CHAT_ID=""
DEVICE_FILTER=""; DEVICE_FILTER_NAMES=""
FILTER_ON=0; BLOCK_ON=0; TG_ON=0
EVENT=""
CURL_PID=""; TSHARK_PID=""; KEY_PID=""
FIFO_PCAP=""; FIFO_OUT=""
ROWS=24; VIEW_TOP=1; VIEW_BOT=22
R_NAME=""
R_KEY=""; R_LINE=""
LOG_BUF=(); LOG_OFF=0; LOG_NEW=0; LOG_VIEW_H=0
BLOCK_ENTRIES=()
DEV_NAME=(); DEV_IP=(); DEV_MAC=(); DEV_IF=(); DEV_COUNT=0

# termios sichern: der Key-Writer (read -s -n 1) wird per kill beendet und
# könnte den Terminal sonst in no-echo/non-canonical zurücklassen
TTY_SAVE=""
[[ -t 0 ]] && TTY_SAVE=$(stty -g 2>/dev/null) || TTY_SAVE=""
restore_tty() {
  [[ -n $TTY_SAVE ]] && stty "$TTY_SAVE" 2>/dev/null
  # kritische Bits garantieren — der Snapshot selbst kann bereits korrupt sein,
  # wenn die Shell den Zustand einer älteren, abgestürzten Session geerbt hat
  stty echo icanon icrnl 2>/dev/null
  return 0
}

# Terminal beim Beenden immer zurücksetzen
trap 'printf "\033[r\033[?1002l\033[?1006l"; tput cnorm 2>/dev/null; restore_tty' EXIT

# ---------- Abhängigkeiten ----------
check_deps() {
  local missing=() t
  for t in figlet curl tshark python3; do
    command -v "$t" >/dev/null 2>&1 || missing+=("$t")
  done
  ((${#missing[@]} == 0)) && return 0
  local brew_pkgs=() apt_pkgs=()
  for t in "${missing[@]}"; do
    case $t in
      tshark)  brew_pkgs+=("wireshark"); apt_pkgs+=("tshark") ;;
      python3) brew_pkgs+=("python");    apt_pkgs+=("python3") ;;
      *)       brew_pkgs+=("$t");        apt_pkgs+=("$t") ;;
    esac
  done
  printf '%s❌ Fehlende Werkzeuge: %s%s\n\n' "$C_RED" "${missing[*]}" "$C_RESET"
  if [[ $(uname -s) == Darwin ]]; then
    printf 'Installation mit Homebrew:\n  %sbrew install %s%s\n' "$C_TEAL" "${brew_pkgs[*]}" "$C_RESET"
  else
    printf 'Installation mit apt-get:\n  %ssudo apt-get install %s%s\n' "$C_TEAL" "${apt_pkgs[*]}" "$C_RESET"
  fi
  exit 1
}

# ---------- UI-Bausteine ----------
banner() {
  printf '%s' "$C_MAUVE"
  figlet -D lauschbox
  printf '%s' "$C_RESET"
}
banner_rows() { figlet -D lauschbox | wc -l | tr -d ' '; }

screen() {  # Banner fixiert oben + 2 Leerzeilen — gilt für die ganze App
  clear
  banner
  echo; echo
}

info() { printf '  %s%s%s\n' "$C_OVERLAY" "$1" "$C_RESET"; }
ok()   { printf '  %s%s%s\n' "$C_GREEN" "$1" "$C_RESET"; }
warn() { printf '  %s%s%s\n' "$C_YELLOW" "$1" "$C_RESET"; }
err()  { printf '  %s%s%s\n' "$C_RED" "$1" "$C_RESET"; }

ask() {  # ask VAR LABEL [secret]
  local __v=$1 __s=${3:-} val
  printf '  %b\n' "$2"
  printf '  %s>%s ' "$C_TEAL" "$C_RESET"
  if [[ -n $__s ]]; then IFS= read -r -s val; echo; else IFS= read -r val; fi
  printf -v "$__v" '%s' "$val"
}

keypress() {
  local _
  printf '\n  %s%s%s' "$C_OVERLAY" "${1:-Enter = weiter}" "$C_RESET"
  IFS= read -r _
}

# read_key: liest eine Taste inkl. Escape-Sequenzen (Pfeile, PgUp/PgDn,
# Home/Ende, Mausrad via SGR-Modus ?1006). Ergebnis in R_KEY:
# einzelnes Zeichen, UP/DOWN/PGUP/PGDN/HOME/END/WUP/WDN, ESC bei nacktem
# Escape, NONE bei unbekannter Sequenz (z.B. Mausklick), "" bei Enter.
# Rückgabe 1 bei EOF.
# Hinweis: bash 3.2 kennt read -t nur mit ganzen Sekunden — Sequenzbytes
# kommen sofort nach; lediglich ein nacktes ESC kostet 1 s Verzögerung.
read_key() {
  R_KEY=""
  local k c seq
  IFS= read -r -s -n 1 k || return 1
  if [[ $k != $'\033' ]]; then R_KEY=$k; return 0; fi
  seq=""
  while IFS= read -r -s -n 1 -t 1 c; do
    seq+="$c"
    [[ $c =~ [A-Za-z~] ]] && break   # finales Byte einer CSI-Sequenz
  done
  case $seq in
    '[A'|'OA')             R_KEY=UP ;;
    '[B'|'OB')             R_KEY=DOWN ;;
    '[5~')                 R_KEY=PGUP ;;
    '[6~')                 R_KEY=PGDN ;;
    '[H'|'[1~'|'[7~'|'OH') R_KEY=HOME ;;
    '[F'|'[4~'|'[8~'|'OF') R_KEY=END ;;
    '[<64;'*)              R_KEY=WUP ;;    # Mausrad hoch (SGR)
    '[<65;'*)              R_KEY=WDN ;;    # Mausrad runter (SGR)
    '[<'*)                 R_KEY=NONE ;;   # Klicks etc. ignorieren
    '')                    R_KEY=ESC ;;
    *)                     R_KEY=NONE ;;
  esac
  return 0
}

confirm_overwrite() {
  local k=""
  printf '  %s⚠️  %s existiert bereits. Überschreiben? [j/N]%s ' "$C_YELLOW" "$1" "$C_RESET"
  IFS= read -r k || return 1
  [[ ${k:0:1} == j ]]
}

# ---------- Konfigurationsdateien ----------
sq() { printf "'"; printf '%s' "$1" | sed "s/'/'\\\\''/g"; printf "'"; }

