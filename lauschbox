# ---------- Menüpunkt 3: Gerätefilter ----------
ui_devices() {
  if ! load_fb; then
    screen
    printf '  %s%s📱 Gerätefilter%s\n\n' "$C_BOLD" "$C_MAUVE" "$C_RESET"
    warn "Keine Fritzbox-Verbindung konfiguriert — bitte zuerst einrichten."
    keypress
    ui_fritzbox || return 1
    load_fb || return 1
  fi
  screen
  printf '  %s%s📱 Gerätefilter%s\n\n' "$C_BOLD" "$C_MAUVE" "$C_RESET"
  info "🔄 Lade Geräteliste von der Fritzbox ($FB_IP) …"
  if ! fetch_devices; then
    err "❌ Geräteliste konnte nicht geladen werden (Zugangsdaten / TR-064 prüfen)."
    keypress; return 1
  fi
  printf '\r\033[2K'
  if ((DEV_COUNT == 0)); then
    warn "Keine verbundenen Geräte gefunden."
    keypress; return 1
  fi
  content_region_on
  if load_filter; then
    printf '  Aktueller Filter: %s%s%s\n\n' "$C_SKY" "$DEVICE_FILTER_NAMES" "$C_RESET"
  fi
  local i icon it
  for ((i = 0; i < DEV_COUNT; i++)); do
    it=${DEV_IF[$i]}
    icon='🔗'
    [[ $it == 802.11 ]] && icon='📶'
    [[ $it == Ethernet ]] && icon='🔌'
    printf '  %s%2d)%s %s %s%-28s%s %s%-15s%s %s%s%s\n' \
      "$C_MAUVE" "$((i + 1))" "$C_RESET" "$icon" \
      "$C_SKY" "${DEV_NAME[$i]:-(ohne Namen)}" "$C_RESET" \
      "$C_BLUE" "${DEV_IP[$i]:--}" "$C_RESET" \
      "$C_OVERLAY" "${DEV_MAC[$i]}" "$C_RESET"
  done
  echo
  printf '  %s a)%s 🌐 Alle Netzwerkgeräte (Auswahl zurücksetzen)\n\n' "$C_MAUVE" "$C_RESET"
  local sel
  ask sel "${C_TEXT}Auswahl — Nummern mit Leerzeichen (z.B. 1 3), a = alle, leer = Abbrechen${C_RESET}"
  if [[ -z $sel ]]; then
    content_region_off
    return 1
  fi
  local rc=0
  if [[ $sel == a ]]; then
    DEVICE_FILTER="ALL"
    DEVICE_FILTER_NAMES="Alle Netzwerkgeräte"
  else
    local okflag=1 w idx
    local -a macs=() names=()
    for w in $sel; do
      if [[ $w =~ ^[0-9]+$ ]] && ((w >= 1 && w <= DEV_COUNT)); then
        idx=$((w - 1))
        macs+=("${DEV_MAC[$idx]}")
        names+=("${DEV_NAME[$idx]:-unbekannt}")
      else
        okflag=0; break
      fi
    done
    if ((okflag == 0)) || ((${#macs[@]} == 0)); then
      err "❌ Ungültige Auswahl: $sel"
      rc=1
    else
      DEVICE_FILTER=$(IFS=,; printf '%s' "${macs[*]}")
      DEVICE_FILTER_NAMES=$(IFS=,; printf '%s' "${names[*]}")
    fi
  fi
  if ((rc == 0)); then
    save_filter
    echo
    ok "✅ Gerätefilter gespeichert: $DEVICE_FILTER_NAMES"
  fi
  keypress
  content_region_off
  return $rc
}

# ---------- Menüpunkt 4: DNS Logging ----------
ui_logging() {
  if ! load_fb; then
    screen
    printf '  %s%s📡 DNS Logging%s\n\n' "$C_BOLD" "$C_MAUVE" "$C_RESET"
    warn "Keine Fritzbox-Verbindung konfiguriert — bitte zuerst einrichten."
    keypress
    ui_fritzbox || return 1
    load_fb || return 1
  fi
  if ! load_filter; then
    screen
    printf '  %s%s📡 DNS Logging%s\n\n' "$C_BOLD" "$C_MAUVE" "$C_RESET"
    info "Noch kein Gerätefilter definiert — bitte Geräte auswählen."
    keypress
    ui_devices || { load_filter || return 1; }
  fi
  screen
  printf '  %s%s📡 DNS Logging%s\n\n' "$C_BOLD" "$C_MAUVE" "$C_RESET"
  info "🔐 Login an Fritzbox ($FB_IP) …"
  if ! fb_login; then
    err "❌ Login fehlgeschlagen — Zugangsdaten prüfen (BlockTime beachten!)."
    keypress; return 1
  fi
  info "🧹 Beende verwaiste Aufzeichnungen …"
  capture_stopall
  info "🔄 Lade Geräteliste zur Namensauflösung …"
  fetch_devices || warn "⚠️  Geräteliste nicht ladbar — Gerätenamen können fehlen."
  FILTER_ON=1; BLOCK_ON=0; TG_ON=0
  load_blocklist || true
  load_tg || true
  trap 'abort_logging' INT TERM
  local ev
  while true; do
    view_setup
    capture_start
    ui_loop
    ev=$EVENT
    capture_stop
    view_teardown
    case $ev in
      x)
        capture_stopall
        trap - INT TERM
        return 0 ;;
      e)
        ui_devices && { load_filter; FILTER_ON=1; fetch_devices || true; } ;;
      t)
        ui_telegram
        if load_tg; then TG_ON=1; else TG_ON=0; fi ;;
      *)
        # Unerwarteter Rücksprung (z.B. FIFO zu): zurück zum Hauptmenü
        capture_stopall
        trap - INT TERM
        return 0 ;;
    esac
  done
}

# ---------- Menüpunkt 5: Sperrliste anzeigen ----------
ui_blocklist() {
  screen
  printf '  %s%s🚫 Sperrliste%s\n\n' "$C_BOLD" "$C_MAUVE" "$C_RESET"
  if [[ ! -f $BLOCKLIST_FILE ]]; then
    blocklist_help
    keypress "Enter = zurück zum Hauptmenü"
    return 0
  fi
  local -a lines=()
  local l truncated=0
  while IFS= read -r l || [[ -n $l ]]; do
    if ((${#lines[@]} >= BLOCKLIST_MAX_LINES)); then truncated=1; break; fi
    lines+=("$l")
  done < "$BLOCKLIST_FILE"
  local total=${#lines[@]}
  if ((total == 0)); then
    warn "(Datei ist leer)"
    keypress "Enter = zurück zum Hauptmenü"
    return 0
  fi
  local bl top h off i idx max_off footer
  ROWS=$(tput lines)
  bl=$(banner_rows)
  top=$((bl + 3))
  h=$((ROWS - top - 1))        # letzte Bildschirmzeile = statischer Footer
  ((h < 1)) && h=1
  off=0
  printf '\033[?1002h\033[?1006h'   # Mausrad-Events (SGR) fürs Scrollen
  # Banner (oberhalb top) und Footer (Zeile ROWS) bleiben statisch;
  # die Einträge werden absolut positioniert — kein \n, kein Scrollen
  while true; do
    for ((i = 0; i < h; i++)); do
      idx=$((off + i))
      printf '\033[%d;1H\033[2K' $((top + i))
      if ((idx < total)); then
        printf '  %s%3d.%s %s%s%s' "$C_MAUVE" $((idx + 1)) "$C_RESET" "$C_TEXT" "${lines[idx]}" "$C_RESET"
      fi
    done
    footer="↑/↓ PgUp/PgDn Home/Ende = scrollen · Enter/q = zurück · $total Einträge"
    ((truncated == 1)) && footer="$footer · ⚠️ Anzeige auf $BLOCKLIST_MAX_LINES Zeilen begrenzt (lauschbox.env)"
    printf '\033[%d;1H\033[2K  %s%s%s' "$ROWS" "$C_OVERLAY" "$footer" "$C_RESET"
    read_key || break
    case $R_KEY in
      UP)   off=$((off - 1)) ;;
      DOWN) off=$((off + 1)) ;;
      PGUP) off=$((off - h)) ;;
      PGDN) off=$((off + h)) ;;
      HOME) off=0 ;;
      END)  off=$((total - h)) ;;
      WUP)  off=$((off - 3)) ;;
      WDN)  off=$((off + 3)) ;;
      ESC|q|x) break ;;
      "")   break ;;          # Enter
      NONE) continue ;;
    esac
    max_off=$((total - h)); ((max_off < 0)) && max_off=0
    ((off < 0)) && off=0
    ((off > max_off)) && off=$max_off
  done
  printf '\033[?1002l\033[?1006l\033[r'
}

# ---------- Hauptmenü ----------
main_menu() {
  local k fbs tgs
  while true; do
    screen
    if [[ -f $ENV_FB ]]; then fbs="${C_GREEN}konfiguriert ✅${C_RESET}"; else fbs="${C_RED}nicht konfiguriert ❌${C_RESET}"; fi
    if [[ -f $ENV_TG ]]; then tgs="${C_GREEN}konfiguriert ✅${C_RESET}"; else tgs="${C_RED}nicht konfiguriert ❌${C_RESET}"; fi
    printf '  %sFritzbox:%s %b   %sTelegram:%s %b\n\n' "$C_TEXT" "$C_RESET" "$fbs" "$C_TEXT" "$C_RESET" "$tgs"
    printf '  %s[1]%s 🔌 Verbindung Fritzbox\n'  "$C_MAUVE" "$C_TEXT"
    printf '  %s[2]%s ✈️  Verbindung Telegram\n'  "$C_MAUVE" "$C_TEXT"
    printf '  %s[3]%s 📱 Gerätefilter\n'          "$C_MAUVE" "$C_TEXT"
    printf '  %s[4]%s 📡 DNS Logging\n'           "$C_MAUVE" "$C_TEXT"
    printf '  %s[5]%s 🚫 Sperrliste anzeigen\n'   "$C_MAUVE" "$C_TEXT"
    printf '  %s[6]%s 👋 Ende%s\n\n'              "$C_MAUVE" "$C_TEXT" "$C_RESET"
    printf '  %sAuswahl [1-6] + Enter:%s ' "$C_OVERLAY" "$C_RESET"
    k=""
    IFS= read -r k || { clear; exit 0; }
    k=${k:0:1}
    case $k in
      1) ui_fritzbox ;;
      2) ui_telegram ;;
      3) ui_devices ;;
      4) ui_logging ;;
      5) ui_blocklist ;;
      6) clear; exit 0 ;;
    esac
  done
}

