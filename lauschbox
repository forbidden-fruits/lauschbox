  elif [[ -f $CONFIG_DIR/web.html && -r $CONFIG_DIR/web.html ]]; then R_LINE="$CONFIG_DIR/web.html"
  fi
  [[ -n $R_LINE ]]
}
((LOG_MAX_LINES > 0)) || LOG_MAX_LINES=1000
